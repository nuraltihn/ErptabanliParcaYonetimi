<Window x:Class="Erpyonetimi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Erpyonetimi"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid >
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding Sidemenugenisligi}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#1F2937" Visibility="{Binding Sidemenugorunme}"  >
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="5" Opacity="0.4" Direction="315" />
            </Border.Effect>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20 25 20 30" Orientation="Horizontal">
                    <Border CornerRadius="5" Background="Gold" Width="36" Height="36" Margin="0 0 12 0">
                    <TextBlock Text="P" FontWeight="bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PARÇAMERP" Foreground="White" FontWeight="bold" FontSize="20"/>
                        <TextBlock Text="Parça Yönetim Sistemi" Foreground="white" FontWeight="bold" FontSize="10"/>

                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="8,5">
                    <Separator Background="Gray" Margin="0 0 0 5"/>
                    <Button Content="Çıkış Yap" Background="Transparent" Foreground="#EF4444" BorderThickness="0" Height="40"
                            HorizontalAlignment="Left" Margin="20 0" Cursor="Hand" />
                </StackPanel>
                <StackPanel>
                    
                    <RadioButton Style="{StaticResource Sidemenubutton}"
                                 GroupName="Sidemenu" IsChecked="true" >
                        <StackPanel Orientation="Horizontal">
                    <TextBlock Text="h" Margin="0 0 12 0"/>
                    <TextBlock Text="DashBoard"/>
                </StackPanel>
                </RadioButton>

                    <RadioButton Style="{StaticResource Sidemenubutton}"
                        GroupName="Sidemenu">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="h" Margin="0 0 12 0"/>
                            <TextBlock Text="Parçalar"/>
                        </StackPanel>
                    </RadioButton>


                    <RadioButton Style="{StaticResource Sidemenubutton}"
                                        GroupName="Sidemenu"
                                  Command="{Binding AdminPanelCommand}"
                                 Visibility="{Binding AdminPanelVisibility}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="h" Margin="0 0 12 0"/>
                            <TextBlock Text="Admin Paneli"/>
                        </StackPanel>
                    </RadioButton>
 
                    <RadioButton Style="{StaticResource Sidemenubutton}"
                            GroupName="Sidemenu">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="h" Margin="0 0 12 0"/>
                            <TextBlock Text="DashBoard"/>
                        </StackPanel>
                    </RadioButton>
                    
                </StackPanel>

            </DockPanel>
        </Border>
        
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>
    </Grid>
</Window>
