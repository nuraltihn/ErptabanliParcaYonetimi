<Application xmlns:vm="clr-namespace:Erpyonetimi.ViewModels"
xmlns:views="clr-namespace:Erpyonetimi.Views"
             x:Class="Erpyonetimi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Erpyonetimi"
           >
    <Application.Resources>
        
        <DataTemplate DataType="{x:Type vm:LoginViewModel}" >
            <views:LoginView/>
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:UsersYonetimViewModel}" >
            <views:UsersYonetimView/>
     </DataTemplate>
        
        
        <DataTemplate DataType="{x:Type vm:TedarikciViewModel}">
            <views:TedarikciView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ParcaViewModel}">
            <views:ParcaView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KategoriViewModel}">
            <views:KategoriView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StokHareketViewModel}">
            <views:StokHareketView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DepoViewModel}">
            <views:DepoView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RafViewModel}">
            <views:RafView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MusteriViewModel}">
            <views:MusteriView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SiparisViewModel}">
            <views:SiparisView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SiparisDetayViewModel}">
            <views:SiparisDetayView/>
        </DataTemplate>
        
        <Style x:Key="Sidemenubutton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="10,3"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="15,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="RoyalBlue"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
    </Application.Resources>
</Application>
