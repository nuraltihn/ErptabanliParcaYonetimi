<UserControl x:Class="Erpyonetimi.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Erpyonetimi.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid  Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#1F2937" CornerRadius="8" Padding="15" Margin="0 0 0 15">
            <TextBlock Text="Dashboard"
           FontSize="22"
           FontWeight="Bold" Foreground="White"/>
        </Border>
        <Grid Grid.Row="1">
           <Border Background="PaleVioletRed" CornerRadius="5" Margin="5" Height="50" Width="400" HorizontalAlignment="Left" BorderBrush="Aqua">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Hosgeldinmsj}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding Rutbemsj}" FontSize="12" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="2" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Background="DarkTurquoise" CornerRadius="7" Margin="5" Height="70" >
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Toplam Kullanıcı Sayısı" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ToplamKullanici}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="DarkTurquoise" CornerRadius="7" Margin="5" Height="70" >
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Toplam Parça Sayısı" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ToplamParca}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="DarkTurquoise" CornerRadius="7" Margin="5" Height="70" >
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Toplam Müşteri Sayısı" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ToplamMusteri}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="DarkTurquoise" CornerRadius="7" Margin="5" Height="70" >
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Toplam Sipariş Sayısı" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ToplamSiparis}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="3" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

                <TextBlock Text="Son Kullanıcılar" Grid.Column="0"  FontSize="15" FontWeight="Bold" Margin="5" Background="LightGray" TextAlignment="Center"/>
                <TextBlock Text="Son Parçalar" Grid.Column="1" FontSize="15" FontWeight="Bold" Margin="5" Background="LightGray" TextAlignment="Center"/>
                <TextBlock Text="Son Siparişler" Grid.Column="2" FontSize="15" FontWeight="Bold" Margin="5" Background="LightGray" TextAlignment="Center"/>
            
        </Grid>
        <Grid Grid.Row="4" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
        
        <DataGrid Grid.Column="0" ItemsSource="{Binding SonKullanicilar}" CanUserAddRows="False" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ad Soyad" Binding="{Binding AdSoyad}"/>
                <DataGridTextColumn Header="Kullanıcı Adı" Binding="{Binding KulAd}"/>
            </DataGrid.Columns>
        </DataGrid>
        <DataGrid Grid.Column="1" ItemsSource="{Binding SonParcalar}" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Parça Adı" Binding="{Binding ParcAdi}"/>
                <DataGridTextColumn Header="Parça Kodu" Binding="{Binding ParcaKodu}"/>
                
            </DataGrid.Columns>
        </DataGrid>
        <DataGrid Grid.Column="2" ItemsSource="{Binding SonSiparisler}" CanUserAddRows="False"
                  >
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sipariş No" Binding="{Binding SiparisNo}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
    </Grid>

  
</UserControl>
