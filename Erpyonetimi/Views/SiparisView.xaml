<UserControl x:Class="Erpyonetimi.Views.SiparisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Erpyonetimi.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#1f2937" CornerRadius="8" Padding="15" Margin="0 0 0 15">
            <TextBlock Text="Sipariş Yönetimi" FontSize="22" FontWeight="bold" Foreground="White"/>
        </Border>

        <Grid Grid.Row="1" Margin="10 0 0 15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>

            </Grid.RowDefinitions>
            <TextBlock Text="Sipariş No:" Grid.Row="0" Grid.Column="0" Margin="5"/>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="5" Width="150" Text="{Binding SiparisNo}"/>
            <TextBlock Text="Müşteri:" Grid.Row="0" Grid.Column="2" Margin="5"/>
            <ComboBox Grid.Row="0" Grid.Column="3" Margin="5" Width="180"
                      ItemsSource="{Binding Musteriler}" SelectedItem="{Binding SeciliMusteri}" DisplayMemberPath="FirmaAdi"/>

            <TextBlock Text=" Sipariş Tarihi" Grid.Row="1" Grid.Column="0" Margin="5"/>
            <DatePicker Grid.Row="1" Grid.Column="1" Margin="5" SelectedDate="{Binding SiparisTarihi}"/>
            <TextBlock Text="Toplam Tutar:" Grid.Row="1" Grid.Column="2" Margin="5"/>
            <TextBox Grid.Row="1" Grid.Column="3" Width="150"  Text="{Binding ToplamTutar}"/>
            
            <TextBlock Text="Durum:" Grid.Row="2" Grid.Column="0" Margin="5"/>
            <ComboBox Grid.Row="2" Grid.Column="1" Margin="5" ItemsSource="{Binding Durumlar}" SelectedItem="{Binding Durum}" Width="150"/>
        </Grid>


            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="10 0 0 10">
                <TextBlock  Text="Ara:" VerticalAlignment="Center" FontSize="14" Margin="5"/>
                <TextBox Width="160" Margin="0 5 0 5" Text="{Binding AramaMetni,UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Ekle" Width="100" Margin="5" Command="{Binding SiparisEkleCommand}" Visibility="{Binding CrudVisibility}"/>
                <Button Content="Güncelle" Width="100" Margin="5" Command="{Binding SiparisGuncelleCommand}" Visibility="{Binding CrudVisibility}"/>
                    <Button Content="Sil" Width="100" Margin="5" Command="{Binding SiparisSilCommand}" Visibility="{Binding CrudVisibility}"/>
                <Button Content="Temizle" Width="100" Margin="5" Command="{Binding SiparisTemizleCommand}" Visibility="{Binding CrudVisibility}"/>
            </StackPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Siparisler}" SelectedItem="{Binding SeciliSiparis}" AutoGenerateColumns="False" CanUserAddRows="False"
                     >
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sipariş No"
                                            Binding="{Binding SiparisNo}"/>
                    <DataGridTextColumn Header="Müşteri"
                                            Binding="{Binding Musteri.FirmaAdi}"/>
                    <DataGridTextColumn Header="Tarih"
                                            Binding="{Binding SiparisTarihi}"/>
                    <DataGridTextColumn Header="Toplam Tutar"
                                            Binding="{Binding ToplamTutar}"/>
                    <DataGridTextColumn Header="Durum"
                                            Binding="{Binding Durum}"/>

                    <DataGridTemplateColumn Header="Detay">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Detay" Background="Yellow" FontWeight="DemiBold" Padding="5" 
                                        Command="{Binding DataContext.DetayAcCommand,
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                               

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
              
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
