<UserControl x:Class="Erpyonetimi.Views.ParcaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Erpyonetimi.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
     
        <TextBlock Text="Parça Yönetimi" Grid.Row="1" FontSize="24" FontFamily="Leelawadee UI" />
        <StackPanel Grid.Row="1" Margin="0 10 10 5" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBox Width="250" Height="30" Margin="0 0 10 0" Text="{Binding AramaMetni}"
                      VerticalAlignment="Center"/>
            <Button Content="Ara" Width="80"
                    Height="30" Command="{Binding AraCommand}"/>
            <Button Content="Yenile"
                    Width="80"
                    Height="30"
                    Margin="10 0 0 0"
                    Command="{Binding ListeleCommand}"/>

        </StackPanel>
        <Border Grid.Row="2"
                BorderBrush="LightGray"
                BorderThickness="1"
                Padding="10"
                Visibility="{Binding CrudVisibility}">
            <Grid>
                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Parça Kodu:"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Margin="5"
                         Text="{Binding ParcaKodu}"/>
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Parça Adı"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Row="1"
         Grid.Column="1"
         Margin="5"
         Text="{Binding ParcAdi}"/>
                <TextBlock Grid.Row="2"
            Grid.Column="0"
            Text="Marka:"
            VerticalAlignment="Center"/>
                <TextBox Grid.Row="2"
             Grid.Column="1"
             Margin="5"
             Text="{Binding     Marka}"/>

                <TextBlock Grid.Row="3"
            Grid.Column="0"
            Text="Alış Fiyatı:"
            VerticalAlignment="Center"/>
                <TextBox Grid.Row="3"
             Grid.Column="1"
             Margin="5"
             Text="{Binding     AlisFiyat}"/>
                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Satış Fiyatı:"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Row="4"
                         Grid.Column="1"
                         Margin="5"
                         Text="{Binding SatisFiyat}"/>
                <TextBlock Grid.Row="5"
                           Grid.Column="0"
                           
                           Text="Mevcut Stok:"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Row="5"
                         Grid.Column="1"
                         Margin="5"
                         Text="{Binding MevcutStok}"/>
                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           
                           Text="Minimum Stok:"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Row="6"
                         Grid.Column="1"
                         Margin="5"
                         Text="{Binding MinimumStok}"/>
                <TextBlock Grid.Row="7"
                           Grid.Column="0"
                           Text="Açıklama:"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Row="7"
                         Grid.Column="1"
                         Margin="5"
                         Text="{Binding Aciklama}"/>
            
            <TextBlock Text="Kategori:"
                           Grid.Row="8"
                           Grid.Column="0"
                           VerticalAlignment="Center"/>
                <ComboBox  Grid.Row="8"
                           Grid.Column="1"
                           Margin="5"
                    ItemsSource="{Binding Kategoriler}"
                          SelectedItem="{Binding SeciliKategori}"
                          DisplayMemberPath="KategoriAdi"/>

                <TextBlock Text="Tedarikçi:"
               Grid.Row="9"
               Grid.Column="0"
               VerticalAlignment="Center"/>
                <ComboBox  Grid.Row="9"
               Grid.Column="1"
               Margin="5"
        ItemsSource="{Binding Tedarikciler}"
              SelectedItem="{Binding SeciliTedarikci}"
              DisplayMemberPath="TedarikciAdi"/>
                
                <Grid Grid.Row="10" Grid.Column="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content=" Ekle" Grid.Column="0" Margin="5"/>
                    <Button Content="Güncelle" Grid.Column="1" Margin="5" />
                    <Button Content="Sil" Grid.Column="2" Margin="5"/>
                </Grid>
            </Grid>
        </Border>
        <DataGrid Grid.Row="11"
                  ItemsSource="{Binding Parcalar}"
                  SelectedItem="{Binding SeciliParca}"
                  AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kod"
                                    Binding="{Binding ParcaKodu}"
                                    Width="120"/>
                <DataGridTextColumn Header="Parça Adı"
                                    Binding="{Binding ParcAdi}"
                                    Width="200"/>
                <DataGridTextColumn Header="Marka"
                                    Binding="{Binding Marka}"
                                    Width="120"/>
                <DataGridTextColumn Header="Alış"
                                    Binding="{Binding AlisFiyat}"
                                    Width="100"/>
                <DataGridTextColumn Header="Satış"
                                    Binding="{Binding SatisFiyat}"
                                    Width="100"/>
                <DataGridTextColumn Header="Stok"
                                    Binding="{Binding MevcutStok}"
                                    Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
        
</UserControl>
