<UserControl x:Class="Erpyonetimi.Views.SiparisDetayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Erpyonetimi.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1F2937" CornerRadius="8" Padding="15" Margin="0 0 0 15">
            <TextBlock Text="Sipariş Detayı" Foreground="White" FontWeight="Bold" FontSize="22"/>
        </Border>

        <Grid Grid.Row="1" Margin="0 0 0 15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Sipariş:" Grid.Row="0" Grid.Column="0" Margin="5"/>
            <ComboBox Grid.Row="0" Grid.Column="1" Margin="5" ItemsSource="{Binding Siparisler}"
                      SelectedItem="{Binding SeciliSiparis}" DisplayMemberPath="SiparisNo"/>
            <TextBlock Text="Parça:" Grid.Row="0" Grid.Column="2" Margin="5"/>
            <ComboBox Grid.Row="0" Grid.Column="3" Margin="5" ItemsSource="{Binding Parcalar}"
                      SelectedItem="{Binding SeciliParca}" DisplayMemberPath="ParcAdi"/>
            
            <TextBlock Text="Miktar:" Grid.Row="1" Grid.Column="0" Margin="5"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="5" Text="{Binding Miktar}"/>
            
            <TextBlock Text="Birim Fiyat:" Grid.Row="1" Grid.Column="2" Margin="5"/>
            <TextBox Grid.Row="1" Grid.Column="3" Margin="5" Text="{Binding BirimFiyat}" IsReadOnly="True"/>
            
            <TextBlock Text="Toplam Fiyat:" Grid.Row="2" Grid.Column="0" Margin="5"/>
            <TextBox Grid.Row="2" Grid.Column="1" Margin="5" Text="{Binding ToplamFiyat}" IsReadOnly="True"/>
            
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                <TextBlock Text="Ara:" VerticalAlignment="Center" FontSize="14" Margin="5"/>
                <TextBox Width="160" Margin="0 5 0 5" Text="{Binding AramaMetni,UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Ekle" Width="100" Margin="5" Command="{Binding SiparisDetayEkleCommand}" Visibility="{Binding CrudVisibility}"/>
                <Button Content="Güncelle" Width="100" Margin="5" Command="{Binding SiparisDetayGuncelleCommand}" Visibility="{Binding CrudVisibility}"/>
                <Button Content="Sil" Width="100" Margin="5" Command="{Binding SiparisDetaySilCommand}" Visibility="{Binding CrudVisibility}"/>
               
            </StackPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Detaylar}" SelectedItem="{Binding SeciliDetay}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sipariş No" Binding="{Binding Siparis.SiparisNo}" Width="120"/>
                    <DataGridTextColumn Header="Parça" Binding="{Binding Parca.ParcAdi}" Width="*"/>
                    <DataGridTextColumn Header="Miktar" Binding="{Binding Miktar}" Width="120"/>
                    <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding BirimFiyat}" Width="120"/>
                    <DataGridTextColumn Header="Toplam Fiyat" Binding="{Binding ToplamFiyat}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
