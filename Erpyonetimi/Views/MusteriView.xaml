<UserControl x:Class="Erpyonetimi.Views.MusteriView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Erpyonetimi.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#1F2937" CornerRadius="8" Padding="15" Margin="0 0 0 15">
            <TextBlock Text="Müşteri Yönetimi"
                       FontSize="22" FontWeight="Bold"
                       Foreground="White"/>
            
        </Border>

        <Grid Grid.Row="1" Margin="0 0 0 15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                
            </Grid.RowDefinitions>

            <TextBlock Text="Müşteri Kodu:" Grid.Row="0" Grid.Column="0" Margin="5"/>
            <TextBox Text="{Binding MusteriKodu}" Grid.Row="0" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Firma Adı:" Grid.Row="0" Grid.Column="2" Margin="5"/>
            <TextBox Text="{Binding FirmaAdi}" Grid.Row="0" Grid.Column="3" Margin="5"/>

            <TextBlock Text="Yetkili Kişi:" Grid.Row="1" Grid.Column="0" Margin="5"/>
            <TextBox Text="{Binding YetkiliKisi}" Grid.Row="1" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Adres:" Grid.Row="1" Grid.Column="2" Margin="5"/>
            <TextBox Text="{Binding Adres}" Grid.Row="1" Grid.Column="3" Margin="5"/>

            <TextBlock Text="Ad:" Grid.Row="2" Grid.Column="0" Margin="5"/>
            <TextBox Text="{Binding Ad}" Grid.Row="2" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Şehir:" Grid.Row="2" Grid.Column="2"  Margin="5"/>
            <TextBox Text="{Binding Sehir}" Grid.Row="2" Grid.Column="3" Margin="5"/>

            <TextBlock Text="Soyad:" Grid.Row="3" Grid.Column="0" Margin="5"/>
            <TextBox Text="{Binding Soyad}" Grid.Row="3" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Telefon:" Grid.Row="3" Grid.Column="2" Margin="5"/>
            <TextBox Text="{Binding Tel}" Grid.Row="3" Grid.Column="3" Margin="5"/>

            <TextBlock Text="Email:" Grid.Row="4" Grid.Column="0" Margin="5"/>
            <TextBox Text="{Binding Email }" Grid.Row="4" Grid.Column="1" Margin="5"/>
            <TextBlock Text="Vergi No:" Grid.Row="4" Grid.Column="2" Margin="5"/>
            <TextBox Text="{Binding VergiNo}" Grid.Row="4" Grid.Column="4" Margin="5"/>


            
            </Grid>
            
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0 0 0 10">
            <TextBlock Margin="10 0 0 0" Text="Ara:" FontSize="14" VerticalAlignment="Center"/>
            <TextBox Width=" 250" Margin="10 5 5 5" Text="{Binding AramaMetni,UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Ekle" Width="80" Margin="5" Command="{Binding MusteriEkleCommand}" Style="{StaticResource Crudbutton}"  />
            <Button Content="Güncelle" Width="100" Margin="5" Command="{Binding MusteriGuncelleCommand}" Style="{StaticResource Crudbutton}"  />
            <Button Content="Sil" Width="50" Margin="5" Command="{Binding MusteriSilCommand}"  Style="{StaticResource Crudbutton}" />
            <Button Content="Temizle" Width="100" Margin="5" Command="{Binding MusteriTemizleCommand}" Style="{StaticResource Crudbutton}"  />
            </StackPanel>
                  <DataGrid Grid.Row="3" ItemsSource="{Binding Musteriler}"
                            SelectedItem="{Binding SeciliMusteri}"
                            AutoGenerateColumns="False" CanUserAddRows="False">
                      <DataGrid.Columns>
                          <DataGridTextColumn Header="Kod" Binding="{Binding MusteriKodu}" Width="100"/>
                          <DataGridTextColumn Header="Firma" Binding="{Binding FirmaAdi}" Width="100"/>
                          <DataGridTextColumn Header="Yetkili Kişi" Binding="{Binding YetkiliKisi}" Width="100"/>
                          <DataGridTextColumn Header="Telefon" Binding="{Binding Tel}" Width="100"/>
                          <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="100"/>
                          <DataGridTextColumn Header="Adres" Binding="{Binding Adres}" Width="100"/>
                          <DataGridTextColumn Header="Şehir" Binding="{Binding Sehir}" Width="100"/>
                          <DataGridTextColumn Header="VergiNo" Binding="{Binding VergiNo}" Width="100"/>
                      </DataGrid.Columns>
                  </DataGrid>
                               
            
            
    </Grid>
</UserControl>
