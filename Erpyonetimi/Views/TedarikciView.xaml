<UserControl x:Class="Erpyonetimi.Views.TedarikciView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Erpyonetimi.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
           
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#1F2937"
                CornerRadius="8" Padding="15" Margin="0 0 0 15">
        <TextBlock Text="Tedarikçi Yönetimi" FontSize="22" FontWeight="bold" Foreground="white"/>
      
</Border>
        <Grid Grid.Row="1" >
            <StackPanel Orientation="Horizontal" Margin="0 10 0 10">
                <TextBlock Text="Ara" VerticalAlignment="Center"
                           Margin="15 0 10 0"/>
                <TextBox Width="250"
                         Text="{Binding AraMetni, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Content="Ara:" 
                        Width="100"
                        Margin="10 0 0 0"
                        Command="{Binding AraCommand}"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Margin="10 0 0 15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Tedarikçi Kodu:" Grid.Row="0" Grid.Column="0" Margin="5 0 0 0"/>
            <TextBox Text="{Binding TedarikciKodu}" Grid.Row="0" Grid.Column="1" Width="150" HorizontalAlignment="Left" Margin=" 5"/>

            <TextBlock Text="Firma Adı:" Grid.Row="0" Grid.Column="2" Margin="5" HorizontalAlignment="Right"/>
            <TextBox Text="{Binding FirmAdi}" Grid.Row="0" Grid.Column="3" Width="150" HorizontalAlignment="Left" Margin="5"/>

            <TextBlock Text="Yetkili Kişi:" Grid.Row="1" Grid.Column="0" Margin="5"/>
            <TextBox Text="{Binding YetkiliKisi}" Grid.Row="1" Grid.Column="1" Width="150" HorizontalAlignment="Left" Margin="5"/>

            <TextBlock Text="Telefon:" Grid.Row="1" Grid.Column="2" Margin="5" HorizontalAlignment="Right"/>
            <TextBox Text="{Binding Tel}" Grid.Row="1" Grid.Column="3" Width="150" HorizontalAlignment="Left" Margin="5"/>

            <TextBlock Text="Email:" Grid.Row="2" Grid.Column="0" Margin="5"/>
            <TextBox Text="{Binding Email}" Grid.Row="2" Grid.Column="1" Width="150" HorizontalAlignment="Left" Margin="5"/>

            <TextBlock Text="Vergi No:" Grid.Row="2" Grid.Column="2" Margin="5" HorizontalAlignment="Right"/>
            <TextBox Text="{Binding VergiNo}" Grid.Row="2" Grid.Column="3" Width="150" HorizontalAlignment="Left" Margin="5"/>


            <TextBlock Text="Fax:" Grid.Row="3" Grid.Column="0" Margin="5"/>
            <TextBox Text="{Binding Fax}" Grid.Row="3" Grid.Column="1" Width="150" HorizontalAlignment="Left" Margin="5"/>

            <TextBlock Text="Adres:" Grid.Row="3" Grid.Column="2" Margin="5" HorizontalAlignment="Right"/>
            <TextBox Text="{Binding Adres}" Grid.Row="3" Grid.Column="3" Width="150" HorizontalAlignment="Left" Margin="5"/>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                <Button Content=" Ekle" Width="100" Margin="5" Command="{Binding TedarikciEkleCommand}"/>
                <Button Content="Güncelle" Width="100" Margin="5" Command="{Binding TedarikciGuncelleCommand}"/>
                <Button Content="Sil" Width="100" Margin="5" Command="{Binding TedarikciGuncelleCommand}"/>
            </StackPanel>
            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Tedarikciler}"
                      SelectedItem="{Binding SeciliTedarikci}"
                      AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Kod"
                                        Binding="{Binding TedarikciKodu}"/>
                    <DataGridTextColumn Header="Firma Adı"
                     Binding="{Binding FirmaAdi}"/>

                    <DataGridTextColumn Header="Yetkili Kişi"
                     Binding="{Binding YetkiliKisi}"/>
                    
                    <DataGridTextColumn Header="Telefon"
                     Binding="{Binding Tel}"/>

                    <DataGridTextColumn Header="Email"
                                        Binding="{Binding Email}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

    </Grid>
</UserControl>
