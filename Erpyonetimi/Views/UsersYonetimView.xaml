<UserControl x:Class="Erpyonetimi.Views.UsersYonetimView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Erpyonetimi.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height=" auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height=" auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
        <TextBlock Grid.Row="0" Text="Ad Soyad"/>
            <TextBox Grid.Row="1" Text="{Binding AdsoyadCommand}" Width="150" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="0" Text="Kullanıcı Adı"/>
            <TextBox Grid.Row="1" Text="{Binding AdsoyadCommand}" Width="150" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="0" Text="Email"/>
            <TextBox Grid.Row="1" Text="{Binding AdsoyadCommand}" Width="150" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="0" Text="Rol"/>
            <TextBox Grid.Row="1" Text="{Binding AdsoyadCommand}" Width="150" HorizontalAlignment="Left" />
            
        <Button Grid.Row="3" Content="Ekle" Width="50" HorizontalAlignment="Left" Margin="20 5 0 5"/>
        <Button Grid.Row="3" Content="Sil" Width="50" HorizontalAlignment="left" Margin="20 0 0 5"/>
        <Button Grid.Row="3" Content="Güncelle" Width="50" HorizontalAlignment="Left" Margin="20 0 0 5"/>

           
        </StackPanel>
        <DataGrid ItemsSource="{Binding Userlar}" Grid.Row="7"/>


    </Grid>
</UserControl>
