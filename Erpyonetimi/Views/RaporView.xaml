<UserControl x:Class="Erpyonetimi.Views.RaporView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Erpyonetimi.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#1F2937" CornerRadius="8" Padding="15" Margin="0 0 0 15">
            <TextBlock Text="Raporlama" Foreground="White" FontWeight="Bold" FontSize="22"/>
        </Border>

        <Grid Grid.Row="1" Margin="0 0 0 15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Rapor:" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
            <ComboBox Grid.Column="1" Margin="5" Height="30" ItemsSource="{Binding Raporlar}"
                      SelectedItem="{Binding SecilenRapor}" />
            <Button Content="Excel" Grid.Column="2" Width="100" Height="30" Margin="5" Command="{Binding ExcelAktarCommand}"  Style="{StaticResource Crudbutton}" />
          
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding SecilenRapor}"
                       FontSize="16" FontWeight="Bold" Margin="5 0 0 10"/>

            <DataGrid Grid.Row="1" Visibility="{Binding StokDurumVisibility}" ItemsSource="{Binding Parcalar}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Parça Kodu" Binding="{Binding ParcaKodu}" Width="120"/>
                    <DataGridTextColumn Header="Parça Adı" Binding="{Binding ParcAdi}" Width="*"/>
                    <DataGridTextColumn Header="Marka" Binding="{Binding Marka}" Width="120"/>
                    <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori.KategoriAdi}" Width="120"/>
                    <DataGridTextColumn Header="Tedarikçi" Binding="{Binding Tedarikci.FirmaAdi}" Width="120"/>
                    <DataGridTextColumn Header="Mevcut Stok" Binding="{Binding MevcutStok}" Width="120"/>
                    <DataGridTextColumn Header="Minimum Stok" Binding="{Binding MinimumStok}" Width="120"/>
                    <DataGridTextColumn Header="Alış Fiyatı" Binding="{Binding AlisFiyat}" Width="120"/>
                    <DataGridTextColumn Header="Satış Fiyatı" Binding="{Binding SatisFiyat}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid Visibility="{Binding KritikStokVisibility}" ItemsSource="{Binding Parcalar}" AutoGenerateColumns="False"
                      CanUserAddRows="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Parça Kodu" Binding="{Binding ParcaKodu}" Width="150"/>
                    <DataGridTextColumn Header="Parça Adı" Binding="{Binding ParcAdi}" Width="*"/>
                    <DataGridTextColumn Header="Mevcut Stok" Binding="{Binding MevcutStok}" Width="150"/>
                    <DataGridTextColumn Header="Minimum Stok" Binding="{Binding MinimumStok}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid Grid.Row="1" Visibility="{Binding StokHareketVisibility}" ItemsSource="{Binding StokHareketleri}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                <DataGrid.Columns>
                    
                    <DataGridTextColumn Header="Parça Kodu" Binding="{Binding Parca.ParcaKodu}" Width="*"/>
                    <DataGridTextColumn Header="Parça" Binding="{Binding Parca.ParcAdi}" Width="*"/>
                    <DataGridTextColumn Header="İşlem" Binding="{Binding IslemTipi}" Width="120"/>
                    <DataGridTextColumn Header="Miktar" Binding="{Binding Miktar}" Width="120"/>
                    <DataGridTextColumn Header="Tarih" Binding="{Binding Tarih}" Width="120"/>
                    <DataGridTextColumn Header="Depo" Binding="{Binding Depo.Depaadi}" Width="120"/>
                    <DataGridTextColumn Header="Kullanıcı" Binding="{Binding Kullanici.AdSoyad}" Width="120"/>
                    <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid Visibility="{Binding SiparisVisibility}" ItemsSource="{Binding Siparisler}" AutoGenerateColumns="False"
          CanUserAddRows="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sipariş No" Binding="{Binding SiparisNo}" Width="150"/>
                    <DataGridTextColumn Header="Müşteri" Binding="{Binding Musteri.FirmaAdi}" Width="150"/>
                    <DataGridTextColumn Header="Sipariş Tarihi" Binding="{Binding SiparisTarihi}" Width="*"/>
                    <DataGridTextColumn Header="Durum" Binding="{Binding Durum}" Width="150"/>
                    <DataGridTextColumn Header="Toplam Tutar" Binding="{Binding ToplamTutar}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>



        </Grid>
            
    </Grid>
</UserControl>
