@page "/shelves"
@rendermode InteractiveServer
@using System.Threading.Tasks
@using Erpyonetimi.Domain.Entities
@using Erpyonetimi.Data.Helpers
@using Erpyonetimi.Application.Services.Interfaces


@inject IRafService RafService
@inject IDepoService DepoService
@inject ILogService LogService
@inject NavigationManager Navigation

<h3>Raf Yönetimi</h3>
<button class="btn btn-primary"
@onclick="YeniRaf">
+Yeni Raf
</button>
<div class="mt-3 mb-3">
	<input class="form-control"
	placeholder="Raf kodu ara..."
	@bind="aramaMetni"
	@bind:event="oninput" />

</div>

<table class="table table-striped mt-3">
	<thead>
		<tr>
			<th>Raf Kodu</th>
			<th>Depo</th>
			<th>İşlemler</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var raf in raflar.Where(x => x.RafKodu.ToLower().Contains(aramaMetni.ToLower())))
		{
			<tr>
				<td>@raf.RafKodu</td>
				<td>@raf.Depo?.Depaadi</td>
				<td>
					<button class="btn btn-warning btn-sm"
					@onclick="() => Duzenle(raf)">
				Düzenle
			</button>
			<button class="btn btn-danger btn-sm ms-2"
			@onclick="() => Sil(raf.Id)">
		Sil
	               </button>
				</td>
			</tr>
		}
	</tbody>
</table>

@if (showModal)
{
	<div class="modal d-block"
	tabindex="-1"
	style="background-color: rgba(0,0,0,0.5);">
<div class="modal-dialog">
	<div class="modal-content">
		<div class="modal-header">
			<h5 class="modal-title">
				@(duzenlemeModu ? "Raf Düzenle" :"Yeni Raf")
			</h5>
			<button type="button"
				class="btn-close"
				@onclick="ModalKapat">
			</button>
		</div>

		<div class="modal-body">

			<div class="mb-3">
				<label>Depo *</label>

        @if (!string.IsNullOrEmpty(hataMesaji))
		{
		<div class="alert alert-danger">
		@hataMesaji
			</div>
		}

				<select class="form-select"
				@bind="yeniRaf.DepoId">
			<option value="0">
				--DepoSeçin--
			</option>
			@foreach (var depo in depolar)
		{
		<option value="@depo.Id">
		@depo.Depaadi
		</option>
		}
		</select>
			</div>

			<div class="mb-3">
				<label>Raf Kodu *</label>
				<input class="form-control"
				@bind="yeniRaf.RafKodu" />
			</div>
		</div>

		<div class="modal-footer">
			<button class="btn btn-secondary"
			@onclick="ModalKapat">
		İptal
	</button>
	<button class="btn btn-success"
	@onclick="Kaydet">
Kaydet
</button>
		</div>
	</div>
</div>
</div>
}
@if (silmeModal)
{
	<div class="modal d-block"
		 tabindex="-1"
		 style="background-color: rgba(0,0,0,0.5);">

		<div class="modal-dialog">
			<div class="modal-content">

				<div class="modal-header">
					<h5 class="modal-title">Raf Silme</h5>

					<button type="button"
							class="btn-close"
							@onclick="SilmeyiIptalEt">
					</button>
				</div>

				<div class="modal-body">

					@if (!string.IsNullOrEmpty(hataMesaji))
					{
						<div class="alert alert-danger">
							@hataMesaji
						</div>
					}

					<p>
						<strong>@silinecekRaf?.RafKodu</strong>
						adlı rafı silmek istediğinize emin misiniz?
					</p>

					<div class="alert alert-warning">
						Bu işlem geri alınamaz.
					</div>

				</div>

				<div class="modal-footer">

					<button class="btn btn-secondary"
							@onclick="SilmeyiIptalEt">
						İptal
					</button>

					<button class="btn btn-danger"
							@onclick="SilmeyiOnayla">
						Evet, Sil
					</button>

				</div>

			</div>
		</div>
	</div>
}
@code
{
	private bool showModal = false;
	private bool duzenlemeModu = false;
	private bool silmeModal = false;
	private Raflar? silinecekRaf;
	private string aramaMetni = "";
	private string hataMesaji = "";
	private List<Raflar> raflar =
	new();
	private List<Depolar> depolar = new();
	private Raflar yeniRaf = new();

	protected override async Task OnInitializedAsync()
	{
		if (!UserSession.IsAdmin && !UserSession.IsDepo)
		{
			Navigation.NavigateTo("/dashboard");
			return;
		}

		raflar = await RafService.GetAllAsync();
		depolar = await DepoService.GetAllAsync();
	}
	private void YeniRaf()
	{
		yeniRaf = new Raflar();
		duzenlemeModu = false;
		hataMesaji = "";
		showModal = true;
	}
	private void ModalKapat()
	{
		showModal = false;
		hataMesaji = "";
	}

	private async Task Kaydet()
	{
		hataMesaji = "";
		if(yeniRaf.DepoId == 0)
		{
			hataMesaji = "Lütfen depo seçiniz.";
			return;
		}
		if(string.IsNullOrWhiteSpace(yeniRaf.RafKodu))
		{
			hataMesaji = "Raf kodu boş bırakılamaz.";
			return;
		}

		if (duzenlemeModu)
		{
			 await RafService.UpdateRafAsync (yeniRaf);

			Log log = new Log();
			log.KullaniciId = UserSession.CurrentUser.Id;
			log.Tarih = DateTime.Now;
			log.Islem = "Raf Düzenleme";
			log.Aciklama = yeniRaf.RafKodu + " adlı raf düzenlendi";
			await LogService.AddAsync(log);
		}
		else
		{
			

			Log log = new Log();
			log.KullaniciId = UserSession.CurrentUser.Id;
			log.Tarih = DateTime.Now;
			log.Islem = "Raf Ekleme";
			log.Aciklama = yeniRaf.RafKodu + " adlı raf eklendi";
			await LogService.AddAsync(log);
		}

		raflar = await RafService.GetAllAsync();
		showModal = false;
		duzenlemeModu = false;
		yeniRaf = new Raflar();
	}
	private void Duzenle (Raflar raf)
	{
		yeniRaf = new Raflar
			{
				Id = raf.Id,
				DepoId = raf.DepoId,
				RafKodu = raf.RafKodu
			};
		duzenlemeModu = true;
		showModal = true;
	}
	private void Sil(int id)
	{
		hataMesaji = "";

		silinecekRaf = raflar.FirstOrDefault(x => x.Id == id);

		if (silinecekRaf != null)
		{
			silmeModal = true;
		}
	}
	private void SilmeyiIptalEt()
	{
		silmeModal= false;
		silinecekRaf= null;
		hataMesaji = "";
	}
	private async Task SilmeyiOnayla()
	{
		if (silinecekRaf == null)
			return;

		try
		{
			await RafService.RemoveRafAsync(silinecekRaf);

			Log log = new Log();
			log.KullaniciId = UserSession.CurrentUser.Id;
			log.Tarih = DateTime.Now;
			log.Islem = "Raf Silme";
			log.Aciklama = silinecekRaf.RafKodu + " adlı raf silindi";
			await LogService.AddAsync(log);

			raflar = await RafService.GetAllAsync();

			hataMesaji = "";
			silmeModal = false;
			silinecekRaf = null;
		}
		catch (Exception ex)
		{
			hataMesaji = ex.Message;
		}
	}
}