@page "/users"
@rendermode InteractiveServer
@using Erpyonetimi.Domain.Entities
@using Erpyonetimi.Application.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using Erpyonetimi.Data.Helpers
@inject ILogService LogService
@inject IUsersService UserService
@inject NavigationManager Navigation

<h3>Kullanıcı Yönetimi</h3>
<hr />
<button class="btn btn-primary" @onclick="YeniKullanici">
    + Yeni Kullanıcı
</button>

<div class="row mt-3 mb-3">
    <div class="col-md-8">
        <input class="form-control"
        placeholder=" Ad Soyad veya kullanıcı adı ara..."
        @bind="aramaMetni"
        @bind:event="oninput"/>
    </div>
    <div class="col-md-4">
        <select class="form-select" @bind="rolFiltresi">
            <option value="0">Tüm Roller</option>
            <option value="1">Admin</option>
            <option value="2">Depo</option>
            <option value="3">Satış</option>
        </select>
    </div>
</div>

@if (showModal)
{
    <div class="modal d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        @(duzenlemeModu ? "Kullanıcı Düzenle" : "Yeni Kullanıcı")
                    </h5>
                    <button type="button" class="btn-close" @onclick="ModalKapat"></button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">Ad Soyad</label>
                        <input class="form-control"
                               @bind="yeniUser.AdSoyad" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Kullanıcı Adı</label>
                        <input class="form-control"
                               @bind="yeniUser.KulAd" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Şifre</label>
                        <input type="password"
                               class="form-control"
                               @bind="yeniUser.Sifre" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Rol</label>
                        <select class="form-select" @bind="yeniUser.RolId">
                            <option value="1">Admin</option>
                            <option value="2">Depo</option>
                            <option value="3">Satış</option>
                        </select>
                    </div>

                </div>

                <div class="modal-footer">

                    <button class="btn btn-secondary"
                            @onclick="ModalKapat">
                        İptal
                    </button>

                    <button class="btn btn-success"
                            @onclick="Kaydet">
                        Kaydet
                    </button>

                </div>

            </div>
        </div>
    </div>
}

<hr />

<table class="table table-striped">

    <thead>

        <tr>
            <th>Ad Soyad</th>
            <th>Kullanıcı Adı</th>
            <th>Rol</th>
            <th>Telefon</th>
            <th>Email</th>
            <th>İşlemler</th>
        </tr>

    </thead>

    <tbody>

        @foreach (var user in FiltrelenmisKullanicilar)
        {
            <tr>
                <td>@user.AdSoyad</td>
                <td>@user.KulAd</td>
                <td>@user.Rol?.RolAdi</td>
                <td>@user.Tel</td>
                <td>@user.Email</td>
                <td>

                    <button class="btn btn-warning btn-sm"
                            @onclick="() => Duzenle(user)">
                        Düzenle
                    </button>

                    <button class="btn btn-danger btn-sm ms-2"
                            @onclick="() => Sil(user.Id)">
                        Sil
                    </button>
                </td>
            </tr>
        }

    </tbody>
</table>

@code
{
    private bool showModal = false;
    private bool duzenlemeModu = false;
    private string aramaMetni = "";
    private int rolFiltresi = 0;

    private List<Users> users = new();

    private Users yeniUser = new();

    protected override void OnInitialized()
    {
        if(!UserSession.IsAdmin)
        {
            Navigation.NavigateTo("/dashboard");
            return;
        }
        users = UserService.GetAllUsers();
    }

    private void YeniKullanici()
    {
        duzenlemeModu = false;
        yeniUser = new Users();
        showModal = true;
    }

    private void ModalKapat()
    {
        showModal = false;
    }

    private void Kaydet()
    {
        if (duzenlemeModu)
        {
            UserService.UpdateUser(yeniUser);
            Log log = new Log();
            log.KullaniciId = UserSession.CurrentUser.Id;
            log.Tarih = DateTime.Now;
            log.Islem = "Kullanıcı Düzenleme";
            log.Aciklama = yeniUser.AdSoyad + " adlı kullanıcı düzenlendi";
            LogService.Add(log);
        }
        else
        {
            UserService.AddUser(yeniUser);
            Log log = new Log();
            log.KullaniciId = UserSession.CurrentUser.Id;
            log.Tarih = DateTime.Now;
            log.Islem = "Kullanıcı Ekleme";
            log.Aciklama = yeniUser.AdSoyad + " adlı kullanıcı eklendi";
            LogService.Add(log);
        }

        users = UserService.GetAllUsers();

        showModal = false;
        duzenlemeModu = false;

        yeniUser = new Users();
    }

    private void Sil(int id)
    {
        var user = users.FirstOrDefault(x => x.Id == id);

        if (user != null)
        {
            UserService.DeleteUser(id);

            Log log = new Log();
            log.KullaniciId = UserSession.CurrentUser.Id;
            log.Tarih = DateTime.Now;
            log.Islem = "Kullanıcı Silme";
            log.Aciklama = user.AdSoyad + " adlı kullanıcı silindi";
            LogService.Add(log);

            users = UserService.GetAllUsers();
        }
    }

    private void Duzenle(Users user)
    {
        yeniUser = new Users
        {
            Id = user.Id,
            AdSoyad = user.AdSoyad,
            KulAd = user.KulAd,
            Sifre = user.Sifre,
            RolId = user.RolId,
            Tel = user.Tel,
            Email = user.Email
        };

        duzenlemeModu = true;
        showModal = true;
    }
    private IEnumerable<Users> FiltrelenmisKullanicilar
    {
        get
        {
            var sonuc = users;
            if (aramaMetni !="")
            {
                sonuc = sonuc.Where(x =>
             x.AdSoyad.ToLower().Contains(aramaMetni.ToLower()) ||
             x.KulAd.ToLower().Contains(aramaMetni.ToLower())
            ).ToList();
            }
            if (rolFiltresi !=0)
            {
                sonuc = sonuc.Where(x => x.RolId == rolFiltresi).ToList();
            }
            return sonuc;
        }
    }
}