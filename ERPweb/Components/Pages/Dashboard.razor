@page "/dashboard"
@using Microsoft.AspNetCore.Components.Authorization
@using Erpyonetimi.Application.Services

@inject AuthenticationStateProvider AuthStateProvider
@inject UsersService UserService          
@inject KategoriService KategoriService   
@inject PartService PartService
 

<div class="container mt-4">
    <h2>ERP Yönetim Paneli</h2>
    <hr />

    <div class="alert alert-primary mb-4">
        Hoş Geldiniz <strong>@kullaniciAdi</strong> | Rol: @rolAdi
    </div>

    <h4 class="mb-3">Genel Durum</h4>
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card bg-light text-center p-3">
                <h5>Toplam Parça</h5>
                <h2>@toplamParcaSayisi</h2>
            </div>
        </div>
     </div>
</div>
<div class="col-md-4 mb-3">
    <div class="card bg-light text-center p-3">
        <h5>Toplam Kategori</h5>
        <h2>@toplamKategoriSayisi</h2>
    </div>
</div>
<div class="col-md-4 mb-3">
    <div class="card bg-light text-center p-3">
        <h5>Toplam Kullanıcı</h5>
        <h2>@toplamKullaniciSayisi</h2>
    </div>
</div>

<h4 class="mb-3">Hızlı Erişim</h4>
<div class="row">
    <div class="col-md-4 mb-2">
        <NavLink href="/parts" class="btn btn-outline-primary w-100">Parça Yönetimi</NavLink>
    </div>
    <div class="col-md-4 mb-2">
        <NavLink href="/categories" class="btn btn-outline-primary w-100">Kategori Yönetimi</NavLink>
    </div>
    <div class="col-md-4 mb-2">
        <NavLink href="/users" class="btn btn-outline-primary w-100">Kullanıcı Yönetimi</NavLink>
    </div>
</div>
@code {
    private string kullaniciAdi = "Admin";
    private string rolAdi = "Yönetici";

    private int toplamParcaSayisi = 0;
    private int toplamKategoriSayisi =0;
    private int toplamKullaniciSayisi = 0;

    protected override void OnInitialized()
    {
        var parcalar = PartService.GetAllParts();
        if(parcalar !=null)
        {
            toplamParcaSayisi = parcalar.Count();

        }
        var kategoriler = KategoriService.GetAllKategori();
        if (kategoriler !=null)
        {
            toplamKategoriSayisi = kategoriler.Count();
        }
        var kullanicilar = UserService.GetAllUsers();
        if (kullanicilar !=null)
        {
            toplamKullaniciSayisi = kullanicilar.Count();
        }
    }
}