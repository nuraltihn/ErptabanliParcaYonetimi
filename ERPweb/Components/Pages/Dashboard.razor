@page "/dashboard"
@using ERPweb.Services
@inject UserService UserService
@inject CategoryService CategoryService

<div class="container mt-4">
    @* 1. Sistem Yöneticisi Paneli *@
    <h2>Sistem Yöneticisi Paneli</h2>
    <hr />
    <p class="text-bg-dark p-2 rounded">Hoş Geldiniz | ERP Veri Yönetimi Ve Modüllerine Hoşgeldiniz</p>
    
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-bg-primary shadow-sm h-100">
                <div class="card-body text-center">
                    <h6 class="text-uppercase mb-1">Toplam Parça</h6>
                    <h3 class="mb-0">1250</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-warning shadow-sm h-100">
                <div class="card-body text-center">
                    <h6 class="text-uppercase mb-1">Toplam Müşteri</h6>
                    <h3 class="mb-0">42</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-info shadow-sm h-100">
                <div class="card-body text-center">
                    <h6 class="text-uppercase mb-1">Toplam Sipariş</h6>
                    <h3 class="mb-0">128</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Bilgilendirici Alan -->
    <div class="row mb-4">
        <div class="col-md-6 mb-3">
            <div class="card border-warning shadow-sm h-100">
                <div class="card-header bg-warning text-dark fw-bold">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Kritik Stok Uyarıları
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Cıvata M8x25 <span class="badge bg-danger rounded-pill">3 Adet Kaldı</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Rulman 6205 <span class="badge bg-danger rounded-pill">1 Adet Kaldı</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="card border-info shadow-sm h-100">
                <div class="card-header bg-info text-dark fw-bold">
                    <i class="bi bi-clock-history me-1"></i> Son Stok Hareketleri Öngörüsü
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-1">Depo giriş/çıkış hareketleri veritabanından anlık çekilmektedir.</p>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">Ahmet Y. - 10 adet Çelik Somun Girişi (Depo A)</li>
                        <li class="list-group-item">Mehmet K. - 2 adet Redüktör Çıkışı (Sevk)</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Sistem Yöneticisi Modülleri -->
    <div class="row mt-4">
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Kullanıcı Yönetimi</h5>
                    <p class="card-text">Sistemdeki kullanıcıları listele, yeni kullanıcı ekle.</p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <NavLink href="/users-management" class="btn btn-dark btn-sm w-100">Yönet</NavLink>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Rol Yönetimi</h5>
                    <p class="card-text">Kullanıcı rollerini ve yetkilerini düzenle.</p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <NavLink href="/roles" class="btn btn-dark btn-sm w-100">Yönet</NavLink>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Müşteri Yönetimi</h5>
                    <p class="card-text">Müşteri ve şirket bilgilerini incele.</p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <NavLink href="/customers" class="btn btn-dark btn-sm w-100">Yönet</NavLink>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Tedarikçi Yönetimi</h5>
                    <p class="card-text">Tedarikçi firma ve yetkili iletişim bilgileri.</p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <NavLink href="/suppliers" class="btn btn-dark btn-sm w-100">Yönet</NavLink>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Depo Yönetimi</h5>
                    <p class="card-text">Fiziksel depo alanları ve konum tanımları.</p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <NavLink href="/warehouses" class="btn btn-dark btn-sm w-100">Yönet</NavLink>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Raf Yönetimi</h5>
                    <p class="card-text">Depo içi raf kodları ve lokasyon yönetimi.</p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <NavLink href="/shelves" class="btn btn-dark btn-sm w-100">Yönet</NavLink>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Sipariş Yönetimi</h5>
                    <p class="card-text">Müşteri siparişleri ve sipariş detay takibi.</p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <NavLink href="/orders" class="btn btn-dark btn-sm w-100">Yönet</NavLink>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Stok Hareketleri</h5>
                    <p class="card-text">Depo giriş/çıkış kayıtları ve stok geçmişi.</p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <NavLink href="/stock-movements" class="btn btn-dark btn-sm w-100">Yönet</NavLink>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int toplamKullaniciSayisi = 0;

    protected override async Task OnInitializedAsync()
    {
        var kullanicilar = await UserService.GetAllUsersAsync();
        if (kullanicilar != null)
        {
            toplamKullaniciSayisi = kullanicilar.Count;
        }
    }
}