@page "/dashboard"

@using Erpyonetimi.Application.Services.Interfaces
@using Erpyonetimi.Data.Helpers
@inject IDashboardService DashboardService

<div class="container mt-4">

    <h2>ERP Yönetim Paneli</h2>
    <hr />

    <div class="alert alert-primary mb-4">
        Hoş Geldiniz
        <strong>@kullaniciAdi</strong>
        | Rol: @rolAdi
    </div>


    <h4 class="mb-3">Genel Durum</h4>
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card bg-light text-center p-3 shadow-sm">
                <h5>Toplam Parça</h5>
                <h2>@toplamParcaSayisi</h2>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card bg-light text-center p-3 shadow-sm">
                <h5>Toplam Kategori</h5>
                <h2>@toplamKategoriSayisi</h2>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card bg-light text-center p-3 shadow-sm">
                <h5>Toplam Kullanıcı</h5>
                <h2>@toplamKullaniciSayisi</h2>
            </div>
        </div>

    </div>
    </div>



@code
{
    private string kullaniciAdi = "";
    private string rolAdi = "";

    private int toplamParcaSayisi = 0;
    private int toplamKategoriSayisi = 0;
    private int toplamKullaniciSayisi = 0;
    protected override async Task OnInitializedAsync()
    {
        if (UserSession.CurrentUser != null)
        {
            kullaniciAdi = UserSession.CurrentUser.AdSoyad;

            if (UserSession.IsAdmin)
            {
                rolAdi = "Yönetici";
            }
            else if (UserSession.IsDepo)
            {
                rolAdi = "Depo";
            }
            else if (UserSession.IsSatis)
            {
                rolAdi = "Satış";
            }
        }
        toplamParcaSayisi = await DashboardService.GetToplamParcaAsync();
        toplamKategoriSayisi = await DashboardService.GetToplamKategoriAsync();
        toplamKullaniciSayisi = await DashboardService.GetToplamKullaniciAsync();
    }
}