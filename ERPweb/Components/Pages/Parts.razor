@page "/parts"
@rendermode InteractiveServer

@using Erpyonetimi.Domain.Entities
@using Erpyonetimi.Application.Services.Interfaces
@using Erpyonetimi.Data.Helpers
@inject IParcaService ParcaService
@inject IKategoriService KategoriService
@inject ITedarikciService TedarikciService
@inject IRafService RafService
@inject ILogService LogService
@inject IDepoService DepoService
@inject NavigationManager Navigation
<h3>Parça Yönetimi</h3>
<hr />

<button class="btn btn-primary" @onclick="YeniParca">
    + Yeni Parça
</button>
<hr />
<div class="row mt-3 mb-3">

    <div class="col-md-8">
        <input class="form-control"
               placeholder="Parça kodu, adı veya marka ara..."
               @bind="aramaMetni"
               @bind:event="oninput" />
    </div>

    <div class="col-md-4">
        <select class="form-select" @bind="kategoriFiltresi">
            <option value="0">Tüm Kategoriler</option>

            @foreach (var kategori in kategoriler)
            {
                <option value="@kategori.Id">
                    @kategori.KategoriAdi
                </option>
            }
        </select>
    </div>
</div>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Parça Kodu</th>
            <th>Parça Adı</th>
            <th>Kategori</th>
            <th>Tedarikçi</th>
            <th>Marka</th>
            <th>Model</th>
            <th>Stok</th>
            <th>Alış Fiyatı</th>
            <th>Satış Fiyatı</th>
            <th>Raf</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var parca in FiltrelenmisParcalar)
        {
            <tr>
                <td>@parca.ParcaKodu</td>
                <td>@parca.ParcAdi</td>
                <td>@parca.Kategori?.KategoriAdi</td>
                <td>@parca.Tedarikci?.FirmaAdi</td>
                <td>@parca.Marka</td>
                <td>@parca.Model</td>
                <td>@parca.MevcutStok</td>
                <td>@parca.AlisFiyat</td>
                <td>@parca.SatisFiyat</td>
                <td>@parca.Raf?.RafKodu</td>
                <td>
                    <button class="btn btn-warning btn-sm"
                            @onclick="() => Duzenle(parca)">
                        Düzenle
                    </button>

                    <button class="btn btn-danger btn-sm ms-2"
                            @onclick="() => Sil(parca.Id)">
                        Sil
                    </button>
                </td>

            </tr>
        }
    </tbody>
</table>

@if (showModal)
{
    <div class="modal d-block tab-index='-1'" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(duzenlemeModu ? "Parça Düzenle" : "Yeni Parça")
                    </h5>
                    <button type="button" class="btn-close" @onclick="ModalKapat"></button>
                </div>
                <div class="modal-body">

                    @if (!string.IsNullOrEmpty(hataMesaji))
                    {
                        <div class="alert alert-danger">
                            @hataMesaji
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Parça Kodu *</label>
                        <input class="form-control" @bind="yeniParca.ParcaKodu" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Parça Adı *</label>
                        <input class="form-control" @bind="yeniParca.ParcAdi" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Kategori *</label>
                        <select class="form-select" @bind="yeniParca.KategoriId">
                            <option value="0">-- Kategori Seçin --</option>
                            @foreach (var kategori in kategoriler)
                            {
                                <option value="@kategori.Id">@kategori.KategoriAdi</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tedarikçi</label>
                        <select class="form-select" @bind="yeniParca.TedarikciId">
                            <option value="0">-- Tedarikçi Seçin --</option>
                            @foreach (var tedarikci in tedarikciler)
                            {
                                <option value="@tedarikci.Id">@tedarikci.FirmaAdi</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Marka</label>
                        <input class="form-control" @bind="yeniParca.Marka" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Model</label>
                        <input class="form-control" @bind="yeniParca.Model" />
                    </div>
                    <div class="mb-3">
                        <label>Malzeme</label>
                        <input class="form-control" @bind="yeniParca.Malzeme"/>
                    </div>
                    <div class="mb-3">
                        <label>Ağırlık</label>
                        <input class="form-control" @bind="yeniParca.Agirlik" />
                    </div>
                    <div class="mb-3">
                        <label>Uzunluk</label>
                        <input type="number" class="form-control" @bind="yeniParca.Uzunluk" />
                    </div>
                     <div class="mb-3">
                         <label>Renk</label>
                         <input class="form-control"
							   @bind="yeniParca.Renk" />
                     </div>
                     <div class="mb-3">
                         <label>Birim *</label>
                         <input class="form-control"
                         @bind="yeniParca.Birim" />
                     </div>

                     <div class="mb-3">
                         <label>Alış Fiyatı *</label>
                         <input type="number" step="0.01"
                         class="form-control"
							   @bind="yeniParca.AlisFiyat" />
					</div>

                            <div class="mb-3">
                                <label>Satış Fiyatı *</label>
                                <input type="number" step="0.01"
                                class="form-control"
                                @bind="yeniParca.SatisFiyat" />
                     </div>
                     <div class="mb-3">
                         <label>Mevcut Stok *</label>
                         <input type="number"
                             class="form-control"
                             @bind="yeniParca.MevcutStok"/>
                     </div>
                     <div class="mb-3">
                         <label>Minimum Stok *</label>
                         <input type="number"
                             class="form-control"
                             @bind="yeniParca.MinimumStok" />
                     </div>
                     <div class="mb-3">
                         <label>Depo *</label>
                         <select class="form-select"
                         @bind="secilenDepoId"
                         @bind:after="DepoDegisti">
                         <option value ="0">-- Depo Seçin --</option>
                         @foreach (var depo in depolar)
                            {
                                <option value ="@depo.Id">
                                @depo.Depaadi
                                </option>
                            }
                        </select>
                     </div>

                     <div class="mb-3">
                         <label>Raf *</label>
                         <select class="form-select"
                         @bind="yeniParca.RafId"
                         disabled="@(secilenDepoId == 0)">

                         <option value="0">--Raf Seçin --</option>
                         @foreach (var raf in raflar.Where(x=>x.DepoId == secilenDepoId))
                            {
                                <option value="@raf.Id">
                                    @raf.RafKodu
                                </option>
                            }

                     </select>
                     </div>
                     <div class="mb-3">
                         <label>Açıklama</label>
                         <textarea class="form-control"
                         rows="3"
                         @bind="yeniParca.Aciklama"></textarea>
                     </div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="ModalKapat">İptal</button>
                    <button class="btn btn-success" @onclick="Kaydet">Kaydet</button>
                </div>
            </div>
        </div>
    </div>
}
@if (silmeModal)
{
    <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Parça Silme</h5>
                    <button type="button" class="btn-close"
                    @onclick="SilmeyiIptalEt"></button>
                </div>

                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(hataMesaji))
                    {
                        <div class="alert alert-danger">
                            @hataMesaji
                        </div>
                    }

                    <p>
                        <strong>@silinecekParca?.ParcAdi</strong>
                        adlı parçayı silmek istediğinize emin misiniz?
                    </p>

                    <div class="alert alert-warning">
                        Bu işlem geri alınamaz.
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" 
                    @onclick="SilmeyiIptalEt">
                        İptal
                    </button>
                    <button class="btn btn-danger" 
                    @onclick="SilmeyiOnayla">
                        Evet, Sil
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code
{
    private bool showModal = false;
    private bool duzenlemeModu = false;
    private string aramaMetni = "";
    private bool silmeModal = false;
    private Parca? silinecekParca;
    private string hataMesaji = "";
    private int kategoriFiltresi = 0;
    private List<Parca> parcalar = new();
    private List<Kategori> kategoriler = new();
    private List<Tedarikci> tedarikciler = new();
    private List<Raflar> raflar = new();
    private List<Depolar> depolar = new();
    private int secilenDepoId = 0;
    private Parca yeniParca = new();

    private IEnumerable<Parca> FiltrelenmisParcalar
    {
        get
        {
            var sonuc = parcalar;
            if (aramaMetni != "")
            {
                string arama = aramaMetni.ToLower();

                sonuc = sonuc.Where(x =>
                    x.ParcaKodu.ToLower().Contains(aramaMetni) ||
                    x.ParcAdi.ToLower().Contains(aramaMetni) ||
                    x.Marka.ToLower().Contains(aramaMetni)
                ).ToList();
            }
            if (kategoriFiltresi != 0)
            {
                sonuc = sonuc.Where(x =>
                    x.KategoriId == kategoriFiltresi
                ).ToList();
            }
            return sonuc;
        }
    }
    protected override void OnInitialized()
    {
        if (!UserSession.IsAdmin && !UserSession.IsSatis)
        {
            Navigation.NavigateTo("/dashboard");
            return;
        }
        parcalar = ParcaService.GetAllParca();
        kategoriler = KategoriService.GetAllKategori();
        tedarikciler = TedarikciService.GetAllTedarikci();
        raflar = RafService.GetAll();
        depolar = DepoService.GetAll();
    }

    private void YeniParca()
    {
        yeniParca = new Parca();
        secilenDepoId = 0;
        duzenlemeModu = false;
        hataMesaji = "";
        showModal = true;
    }

    private void ModalKapat()
    {
        showModal = false;
    }
    private void Kaydet()
    {
        hataMesaji = "";

        if (string.IsNullOrWhiteSpace(yeniParca.ParcaKodu))
        {
            hataMesaji = "Parça kodu boş bırakılamaz.";
            return;
        }

        if (string.IsNullOrWhiteSpace(yeniParca.ParcAdi))
        {
            hataMesaji = "Parça adı boş bırakılamaz.";
            return;
        }

        if (yeniParca.KategoriId == 0)
        {
            hataMesaji = "Lütfen kategori seçiniz.";
            return;
        }

        if (yeniParca.TedarikciId == 0)
        {
            hataMesaji = "Lütfen tedarikçi seçiniz.";
            return;
        }

        if (string.IsNullOrWhiteSpace(yeniParca.Birim))
        {
            hataMesaji = "Birim boş bırakılamaz.";
            return;
        }

        if (yeniParca.AlisFiyat <= 0)
        {
            hataMesaji = "Alış fiyatı 0'dan büyük olmalıdır.";
            return;
        }

        if (yeniParca.SatisFiyat <= 0)
        {
            hataMesaji = "Satış fiyatı 0'dan büyük olmalıdır.";
            return;
        }

        if (yeniParca.MevcutStok < 0)
        {
            hataMesaji = "Mevcut stok 0'dan küçük olamaz.";
            return;
        }

        if (yeniParca.MinimumStok < 0)
        {
            hataMesaji = "Minimum stok 0'dan küçük olamaz.";
            return;
        }
        if (secilenDepoId == 0)
        {
            hataMesaji ="Lütfen depo seçiniz.";
            return;
        }

        if (yeniParca.RafId == 0)
        {
            hataMesaji = "Lütfen raf seçiniz.";
            return;
        }
        if(duzenlemeModu)
        {
            ParcaService.UpdateParca(yeniParca);
            Log log = new Log();
            log.KullaniciId = UserSession.CurrentUser.Id;
            log.Tarih = DateTime.Now;
            log.Islem = "Parça Düzenleme";
            log.Aciklama = yeniParca.ParcAdi + "adlı parça düzenlendi";
            LogService.Add(log);
        }
        else
        {
            ParcaService.AddParca(yeniParca);
            Log log = new Log();
            log.KullaniciId = UserSession.CurrentUser.Id;
            log.Tarih = DateTime.Now;
            log.Islem = "Parça Ekleme";
            log.Aciklama = yeniParca.ParcAdi + "adlı parça eklendi";
            LogService.Add(log);
        }
        parcalar = ParcaService.GetAllParca();
        showModal = false;
        duzenlemeModu = false;
        yeniParca = new Parca();
        secilenDepoId = 0;

    }
    private void Duzenle(Parca parca)
    {
        yeniParca = new Parca
        {
            Id = parca.Id,
            ParcaKodu = parca.ParcaKodu,
            ParcAdi = parca.ParcAdi,
            KategoriId = parca.KategoriId,
            TedarikciId = parca.TedarikciId,
            Marka = parca.Marka,
            Model = parca.Model,
            Malzeme = parca.Malzeme,
            Agirlik = parca.Agirlik,
            Uzunluk = parca.Uzunluk,
            Genislik = parca.Genislik,
            Yukseklik = parca.Yukseklik,
            Renk = parca.Renk,
            Birim = parca.Birim,
            AlisFiyat = parca.AlisFiyat,
            SatisFiyat = parca.SatisFiyat,
            MevcutStok = parca.MevcutStok,
            MinimumStok = parca.MinimumStok,
            RafId = parca.RafId,
            Aciklama = parca.Aciklama
        };
        var raf = raflar.FirstOrDefault(x => x.Id == parca.RafId);
        if(raf != null)
        {
            secilenDepoId = raf.DepoId;
        }
        else
        {
            secilenDepoId = 0;
        }

        duzenlemeModu = true;
        hataMesaji = "";
        showModal = true;
    }
    private void Sil(int id)
    {
        hataMesaji = "";
        silinecekParca = ParcaService.GetById(id);

        if (silinecekParca != null)
        {
            silmeModal = true;
        }
    }
    private void SilmeyiIptalEt()
    {
        silmeModal= false;
        silinecekParca = null;
    }
    private void SilmeyiOnayla()
    {
        if (silinecekParca == null)
            return;

        try
        {
            ParcaService.RemoveParca(silinecekParca);

            Log log = new Log();
            log.KullaniciId = UserSession.CurrentUser.Id;
            log.Tarih = DateTime.Now;
            log.Islem = "Parça Silme";
            log.Aciklama = silinecekParca.ParcAdi + " adlı parça silindi";
            LogService.Add(log);

            parcalar = ParcaService.GetAllParca();

            hataMesaji = "";
            silmeModal = false;
            silinecekParca = null;
        }
        catch (Exception ex)
        {
            hataMesaji = ex.Message;
        }
    }

    private void DepoDegisti()
    {
        yeniParca.RafId = 0;
    }

}