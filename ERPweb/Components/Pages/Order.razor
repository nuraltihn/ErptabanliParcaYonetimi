@page "/orders"
@rendermode InteractiveServer
@using Erpyonetimi.Domain.Entities
@using Erpyonetimi.Application.Services.Interfaces
@using Erpyonetimi.Data.Helpers

@inject ISiparisService SiparisService
@inject IMusteriService MusteriService
@inject ISiparisDetayService SiparisDetayService
@inject IParcaService ParcaService
@inject ILogService LogService
@inject NavigationManager Navigation

<h3>Sipariş Yönetimi</h3>
<button class="btn btn-primary" @onclick="YeniSiparis">
	+Yeni Sipariş
</button>
<div class="row mt-3 mb-3">
	<div class="col-md-8">
		<input class="form-control"
		placeholder="Sipariş no veya müşteri ara..."
		@bind="aramaMetni"
		@bind:event="oninput" />
	</div>
	<div class="col-md-4">
		<select class="form-select" @bind="durumFiltresi">
			<option value="">Tüm Durumlar</option>
			<option value="Bekliyor">Bekliyor</option>
			<option value="Hazırlanıyor">Hazırlanıyor</option>
			<option value="Tamamlandı">Tamamlandı</option>
			<option value="İptal">İptal</option>
		</select>
	</div>
</div>

<table class="table table-striped mt-3">
	<thead>
		<tr>
			<th>Sipariş No</th>
			<th>Müşteri</th>
			<th>Sipariş Tarihi</th>
			<th>Toplam Tutar</th>
			<th>Durum</th>
			<th>İşlemler</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var siparis in FiltrelenmisSiparisler)
		{
			<tr>
				<td>@siparis.SiparisNo</td>
				<td>@siparis.Musteri?.FirmaAdi</td>
				<td>@siparis.SiparisTarihi.ToShortDateString()</td>
				<td>@siparis.ToplamTutar ₺</td>
				<td>@siparis.Durum</td>
				<td>
					<button class="btn btn-warning btn-sm" 
					@onclick="() => Duzenle(siparis)">
						Düzenle
					</button>
					<button class="btn btn-danger btn-sm ms-2"
					@onclick="() => Sil(siparis.Id)">
						Sil
					</button>
					<button class="btn btn-info btn-sm ms-2" title="Sipariş Detayı" 
					@onclick="() => DetayGoster(siparis)">
						ⓘ
					</button>
				</td>
			</tr>
		}
	</tbody>
</table>

@if (showModal)
{
	<div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
	<div class="modal-dialog">
	<div class="modal-content">
	<div class="modal-header">
	<h5 class="modal-title">
	@(duzenlemeModu ? "Sipariş Düzenle" : "Yeni Sipariş")
	</h5>
  <button type="button" class="btn-close"
  @onclick="ModalKapat"></button>
				</div>
	<div class="modal-body">

	@if (!string.IsNullOrEmpty(hataMesaji))
	{
	<div class="alert alert-danger">
	@hataMesaji
	</div>
	}
    <div class="mb-3">
    <label>Sipariş No *</label>
	<input class="form-control"
	@bind="yeniSiparis.SiparisNo" />
					</div>
					<div class="mb-3">
						<label>Müşteri *</label>
						<select class="form-select" 
		 				@bind="yeniSiparis.MusteriId">
							<option value="0">--Müşteri Seçin--</option>
							@foreach (var musteri in musteriler)
							{
								<option value="@musteri.Id">@musteri.FirmaAdi</option>
							}
						</select>
					</div>
					<div class="mb-3">
						<label>Sipariş Tarihi *</label>
						<input type="date" class="form-control" 
						@bind="yeniSiparis.SiparisTarihi" />
					</div>
					<label>Durum *</label>
					<select class="form-select"
							@bind="yeniSiparis.Durum">

						<option value="">-- Durum Seçin --</option>
						<option value="Bekliyor">Bekliyor</option>
						<option value="Hazırlanıyor">Hazırlanıyor</option>
						<option value="Tamamlandı">Tamamlandı</option>
						<option value="İptal">İptal</option>

					</select>
				</div>
				<div class="modal-footer">
					<button class="btn btn-secondary" 
					@onclick="ModalKapat">İptal</button>
					<button class="btn btn-success" 
					@onclick="Kaydet">Kaydet</button>
				</div>
			</div>
		</div>
	</div>
}


@if (detayModal)
{
<div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
<div class="modal-dialog">
<div class="modal-content">
<div class="modal-header">
<h5 class="modal-title">Sipariş Detayı</h5>
<button type="button" class="btn-close" 
@onclick="DetayKapat"></button>
				</div>
				<div class="modal-body">
					@if (seciliSiparis != null)
					{
						<p><strong>Sipariş No:</strong> @seciliSiparis.SiparisNo</p>
						<p><strong>Müşteri:</strong> @seciliSiparis.Musteri?.FirmaAdi</p>
						<p><strong>Tarih:</strong> @seciliSiparis.SiparisTarihi.ToShortDateString()</p>
						<p><strong>Durum:</strong> @seciliSiparis.Durum</p>
						<hr />
						<h6>Parça Ekle</h6>
						<div class="mb-3">
							<label class="form-label">Parça *</label>
							<select class="form-select"
							@bind="yeniDetay.ParcaId">
							<option value="0">--Parça Seçin--</option>
							@foreach(var parca in parcalar)
								{
									<option value="@parca.Id">
										@parca.ParcAdi
									</option>
								}
							</select>
						</div>
						<div class="mb-3">
							<label class="form-label">Miktar *</label>
							<input type="number"
								class="form-control"
								min="1"
								@bind="yeniDetay.Miktar" />

						</div>
						<div class="mb-3">
							<label class="form-label">Birim Fiyat *</label>
							<input type="number"
								class="form-control"
								step="0.01"
								@bind="yeniDetay.BirimFiyat" />
						</div>

						<button class="btn btn-success"
								@onclick="DetayKaydet">

							@(detayDuzenlemeModu ? "Güncelle" : "+Parça Ekle")

						</button>

					<hr />

					<h6>Sipariş Kalemleri</h6>
					@if (siparisDetaylari.Count == 0)
					{
						<p class="text-muted">
							Bu siparişte henüz parça bulunmuyor.
						</p>
					}
					else
					{
						<table class="table table-sm">
							<thead>
								<tr>
									<th>Parça</th>
									<th>Miktar</th>
									<th>Birim Fiyat</th>
									<th>Toplam</th>
									<th>İşlem</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var detay in siparisDetaylari)
								{
									<tr>
										<td>@detay.Parca?.ParcAdi</td>
										<td>@detay.Miktar</td>
										<td>@detay.BirimFiyat</td>
										<td>@detay.ToplamFiyat</td>
											
										<td>
											<button class="btn btn-warning btn-sm"
													@onclick="() => DetayDuzenle(detay)">
												Düzenle
											</button>
											<button class="btn btn-danger btn-sm ms-1"
													@onclick="() => DetaySil(detay)">
												Sil
											</button>
										</td>
									</tr>
								}
							</tbody>
						</table>
					}
				}
			</div>
			<div class="modal-footer">
				<button class="btn btn-secondary"
						@onclick="DetayKapat">
					Kapat
				</button>
			</div>
		</div>
	</div>
</div>
}
@if (silmeModal)
{
    <div class="modal d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5);">

        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Sipariş Silme</h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="SilmeyiIptalEt">
                    </button>
                </div>

                <div class="modal-body">

                    @if (!string.IsNullOrEmpty(hataMesaji))
                    {
                        <div class="alert alert-danger">
                            @hataMesaji
                        </div>
                    }

                    <p>
                        <strong>@silinecekSiparis?.SiparisNo</strong>
                        numaralı siparişi silmek istediğinize emin misiniz?
                    </p>

                    <div class="alert alert-warning">
                        Bu işlem geri alınamaz.
                    </div>

                </div>

                <div class="modal-footer">

                    <button class="btn btn-secondary"
                            @onclick="SilmeyiIptalEt">
                        İptal
                    </button>

                    <button class="btn btn-danger"
                            @onclick="SilmeyiOnayla">
                        Evet, Sil
                    </button>

                </div>

            </div>
        </div>
    </div>
}
@code {
	private bool showModal = false;
	private bool duzenlemeModu = false;
	private Siparis? seciliSiparis;
	private List<SiparisDetaylari> siparisDetaylari = new();
	private bool detayDuzenlemeModu = false;

	private List<Siparis> siparisler = new();
	private List<Musteri> musteriler = new();
	private List<Parca> parcalar = new();
	private string aramaMetni = "";
	private string durumFiltresi = "";
	private SiparisDetaylari yeniDetay = new();
	private Siparis yeniSiparis = new();
	private string hataMesaji = "";
	private bool silmeModal = false;
    private Siparis? silinecekSiparis;
	private bool detayModal = false;


	protected override async Task OnInitializedAsync()
	{
		if (!UserSession.IsAdmin && !UserSession.IsSatis)
		{
			Navigation.NavigateTo("/dashboard");
			return;
		}

		siparisler = await SiparisService.GetAllAsync();
		musteriler = await MusteriService.GetAllAsync();
		parcalar = await ParcaService.GetAllParcaAsync ();
	}
	private IEnumerable<Siparis> FiltrelenmisSiparisler
	{
		get
		{
			var sonuc = siparisler;
			if (aramaMetni != "")
			{
				string arama = aramaMetni.ToLower();
				sonuc = sonuc.Where(x =>
				x.SiparisNo.ToLower().Contains(arama) ||
				x.Musteri.FirmaAdi.ToLower().Contains(arama)
				).ToList();

			}
			if (durumFiltresi != "")
			{
				sonuc = sonuc.Where(x =>
				x.Durum == durumFiltresi
				).ToList();
			}
			return sonuc;
		}
	}

	private void YeniSiparis()
	{
		yeniSiparis = new Siparis();
		hataMesaji = "";
		duzenlemeModu = false;
		showModal = true;
	}

	private void ModalKapat()
	{
		showModal = false;
	}

	private async Task Kaydet()
	{
		hataMesaji = "";

		if (string.IsNullOrWhiteSpace(yeniSiparis.SiparisNo))
		{
			hataMesaji = "Sipariş numarası boş bırakılmaz.";
			return;
		}

		var mevcutSiparisler = await SiparisService.GetAllAsync();

		if (!duzenlemeModu &&
			mevcutSiparisler.Any(x => x.SiparisNo == yeniSiparis.SiparisNo))
		{
			hataMesaji = "Bu sipariş numarası zaten kullanılıyor.";
			return;
		}
		
		if (yeniSiparis.MusteriId == 0)
		{
			hataMesaji = "Lütfen müşteri seçiniz.";
			return;
		}

		if (string.IsNullOrWhiteSpace(yeniSiparis.Durum))
		{
			hataMesaji = "Lütfen sipariş durumu seçiniz.";
			return;
		}

		if (duzenlemeModu)
		{
			await SiparisService.UpdateSiparisAsync(yeniSiparis);
			Log log = new Log();
			log.KullaniciId = UserSession.CurrentUser.Id;
			log.Tarih = DateTime.Now;
			log.Islem = "Sipariş Düzenleme";
			log.Aciklama = yeniSiparis.SiparisNo + " numaralı sipariş düzenlendi";
			 await LogService.AddAsync (log);
		}
		else
		{
			await SiparisService.AddSiparisAsync (yeniSiparis);

			Log log = new Log();
			log.KullaniciId = UserSession.CurrentUser.Id;
			log.Tarih = DateTime.Now;
			log.Islem = "Sipariş Ekleme";
			log.Aciklama = yeniSiparis.SiparisNo + " numaralı sipariş oluşturuldu";
			await LogService.AddAsync(log);
		}

		siparisler = await SiparisService.GetAllAsync ();

		showModal = false;
		duzenlemeModu = false;
		yeniSiparis = new Siparis();
	}

	private void Duzenle(Siparis siparis)
	{
		yeniSiparis = new Siparis
		{
			Id = siparis.Id,
			SiparisNo = siparis.SiparisNo,
			MusteriId = siparis.MusteriId,
			SiparisTarihi = siparis.SiparisTarihi,
			ToplamTutar = siparis.ToplamTutar,
			Durum = siparis.Durum
		};
		duzenlemeModu = true;
		showModal = true;
	}

	private void Sil(int id)
{
    hataMesaji = "";

    silinecekSiparis = siparisler.FirstOrDefault(x => x.Id == id);

    if (silinecekSiparis != null)
    {
        silmeModal = true;
    }
}
   private void SilmeyiIptalEt()

  {
    silmeModal = false;
    silinecekSiparis = null;
    hataMesaji = "";
   }
   private async Task SilmeyiOnayla()
{
    if (silinecekSiparis == null)
        return;

    try
    {
       await SiparisService.RemoveSiparisAsync (silinecekSiparis);

        Log log = new Log();
        log.KullaniciId = UserSession.CurrentUser.Id;
        log.Tarih = DateTime.Now;
        log.Islem = "Sipariş Silme";
        log.Aciklama = silinecekSiparis.SiparisNo
            + " numaralı sipariş silindi";
        await LogService.AddAsync (log);

        siparisler = await SiparisService.GetAllAsync ();

        hataMesaji = "";
        silmeModal = false;
        silinecekSiparis = null;
    }
    catch (Exception ex)
    {
        hataMesaji = ex.Message;
    }
}
	private async Task DetayGoster(Siparis siparis)
	{
		seciliSiparis = siparis;
		var detaylar = await SiparisDetayService.GetAllAsync();

		siparisDetaylari = detaylar
			.Where(x => x.SiparisId == siparis.Id)
			.ToList();
		yeniDetay = new SiparisDetaylari();
		detayModal = true;
	}
	private async Task DetayKaydet()
	{
		if (seciliSiparis == null)
			return;

		if (yeniDetay.ParcaId == 0)
		{
			hataMesaji = "Lütfen parça seçiniz.";
			return;
		}
		if (yeniDetay.Miktar <= 0)
		{
			hataMesaji = "Miktar 0'dan büyük olmalıdır.";
			return;
		}
		if (yeniDetay.BirimFiyat <= 0)
		{
			hataMesaji = "Birim fiyat 0'dan büyük olmalıdır.";
			return;
		}

		yeniDetay.SiparisId = seciliSiparis.Id;
		yeniDetay.ToplamFiyat =
			yeniDetay.Miktar * yeniDetay.BirimFiyat;

		if (detayDuzenlemeModu)
		{
			await SiparisDetayService.UpdateDetayAsync (yeniDetay);
		}
		else
		{
			yeniDetay.Id = 0;
			await SiparisDetayService.AddDetayAsync(yeniDetay);
		}
		var detaylar = await SiparisDetayService.GetAllAsync();

		siparisDetaylari = detaylar
			.Where(x => x.SiparisId == seciliSiparis.Id)
			.ToList();

		await SiparisToplaminiGuncelle();
	
		yeniDetay = new SiparisDetaylari();
		detayDuzenlemeModu = false;
	}

	private void DetayKapat()
	{
		detayModal = false;
		seciliSiparis = null;
		siparisDetaylari = new List<SiparisDetaylari>();
	}

	private async Task DetaySil(SiparisDetaylari detay)
	{
		await SiparisDetayService.DeleteDetayAsync (detay);
		if (seciliSiparis != null)
		{
			var detaylar = await SiparisDetayService.GetAllAsync();

			siparisDetaylari = detaylar
				.Where(x => x.SiparisId == seciliSiparis.Id)
				.ToList();

			await SiparisToplaminiGuncelle();
		}
	}
	private void DetayDuzenle(SiparisDetaylari detay)
	{
		yeniDetay = new SiparisDetaylari
		{
			Id = detay.Id,
			SiparisId = detay.SiparisId,
			ParcaId = detay.ParcaId,
			Miktar = detay.Miktar,
			BirimFiyat = detay.BirimFiyat,
			ToplamFiyat = detay.ToplamFiyat
		};

		detayDuzenlemeModu = true;
	}

	private async Task SiparisToplaminiGuncelle()
	{
		if (seciliSiparis == null)
			return;
		seciliSiparis.ToplamTutar = siparisDetaylari
		.Sum(x => x.ToplamFiyat);
		await SiparisService.UpdateSiparisAsync (seciliSiparis);
		siparisler = await SiparisService.GetAllAsync ();
	}
}

