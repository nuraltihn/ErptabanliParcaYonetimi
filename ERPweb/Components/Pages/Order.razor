@page "/orders"
@rendermode InteractiveServer

@using Erpyonetimi.Domain.Entities
@using Erpyonetimi.Application.Services.Interfaces

@inject ISiparisService SiparisService
@inject IMusteriService MusteriService

<h3>Sipariş Yönetimi</h3>

<button class="btn btn-primary" @onclick="YeniSiparis">
	+Yeni Sipariş
</button>


<table class="table table-striped mt-3">
	<thead>
		<tr>
			<th>Sipariş No</th>
			<th>Müşteri</th>
			<th>Sipariş Tarihi</th>
			<th>Toplam Tutar</th>
			<th>Durum</th>
			<th>İşlemler</th>
		</tr>

	</thead>
	<tbody>
		@foreach (var siparis in siparisler)
		{
			<tr>
				<td>@siparis.SiparisNo</td>
				<td>@siparis.Musteri?.FirmaAdi</td>
				<td>@siparis.SiparisTarihi.ToShortDateString()</td>
				<td>@siparis.ToplamTutar ₺</td>
				<td>@siparis.Durum</td>
				<td>
					<button class="btn btn-warning btn-sm"
					@onclick="() => Duzenle(siparis)">
						Düzenle
					</button>
					<button class="btn btn-danger btn-sm ms-2"
					@onclick="() => Sil(siparis.Id)">
						Sil
					</button>

					<button class="btn btn-info btn-sm ms-2"
							title="Sipariş Detayı">
						ⓘ
					</button>

	
				</td>
			</tr>
		}
	</tbody>
</table>
@if (showModal)
{
	<div class="modal d-block" tabindex="-1"
	style="background-color :rgba(0,0,0,0.5);">

    <div> class="modal-dialog">
		<div class="modal-content">

			<div class="modal-header">
				<h5 class="modal-title">
					@(duzenlemeModu ? "Sipariş Düzenle" :"Yeni Sipariş")
				</h5>
				<button type="button"
					class="btn-close"
					@onclick="ModalKapat">
				</button>
			</div>
			<div class="modal-body">
				<div class="mb-3">
					<label>Sipariş No</label>
					<input class="form-control"
					@bind="yeniSiparis.SiparisNo" />
				</div>
				<div class="mb-3">
					<label>Müşteri</label>
					<select class="form-select"
					@bind="yeniSiparis.MusteriId">
					<option value="0">--Müşteri Seçin--</option>
					@foreach(var musteri in musteriler)
							{
								<option value="@musteri.Id">
									@musteri.FirmaAdi
								</option>
							}
						</select>
				</div>
				<div class="mb-3">
					<label>Sipariş Tarihi</label>
					<input type="date"
						class="form-control"
						@bind="yeniSiparis.SiparisTarihi" />
				</div>

				<div class="mb-3">
					<label>Toplam Tutar</label>
					<input type="number"
						step="0.01"
						class="form-control"
						@bind="yeniSiparis.ToplamTutar" />
				</div>

				<div class="mb-3">
					<label>Durum</label>
					<select class="form-select"
					@bind="yeniSiparis.Durum">
					<option value="Bekliyor">Bekliyor</option>
					<option value="Hazırlanıyor">Hazırlanıyor</option>
					<option value="Tamamlandı">Tamamlandı</option>
					<option value="İptal">İptal</option>
				</select>
				</div>
			</div>
			<div class="modal-footer">
				<button class="btn btn-secondary"
				@onclick="ModalKapat">
			    İptal
		</button>
		<button class="btn btn-success"
		@onclick="Kaydet">
	          Kaydet
     </button>
			</div>
		</div>

</div>
</div>
}
@code 
{
	private bool showModal = false;
	private bool duzenlemeModu = false;
	private List<Siparis> siparisler = new();
	private List<Musteri> musteriler = new();
	private Siparis yeniSiparis = new();
	protected override void OnInitialized()
	{
		siparisler = SiparisService.GetAll();
		musteriler = MusteriService.GetAll();

	}
	private void YeniSiparis()
	{
		yeniSiparis = new Siparis();
		duzenlemeModu = false;
		showModal = true;
	}
	private void ModalKapat()
	{
		showModal = false;
	}
	private void Kaydet()
	{
		if(duzenlemeModu)
		{
			SiparisService.UpdateSiparis(yeniSiparis);
		}
		else
		{
			SiparisService.AddSiparis(yeniSiparis);
		}
		siparisler = SiparisService.GetAll();

		showModal = false;
		duzenlemeModu = false;
		yeniSiparis = new Siparis();
	}
	private void Duzenle(Siparis siparis)
	{
		yeniSiparis = new Siparis
			{
				Id = siparis.Id,
				SiparisNo = siparis.SiparisNo,
				MusteriId = siparis.MusteriId,
				SiparisTarihi = siparis.SiparisTarihi,
				ToplamTutar = siparis.ToplamTutar,
				Durum = siparis.Durum
			};
		duzenlemeModu = true;
		showModal = true;
	}
	private void Sil(int id)
	{
		var siparis = SiparisService.GetById(id);
		if (siparis != null)
		{
			SiparisService.RemoveSiparis(siparis);
			siparisler = SiparisService.GetAll();
		}
	}
}
