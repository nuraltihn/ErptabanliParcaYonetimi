@page "/stockmovements"
@rendermode InteractiveServer

@using Erpyonetimi.Domain.Entities
@using Erpyonetimi.Application.Services.Interfaces
@using Erpyonetimi.Data.Helpers
@inject IParcaService ParcaService
@inject IDepoService DepoService
@inject IUsersService UserService
@inject IStokHareketService StokHareketService
@inject NavigationManager Navigation

<h3>Stok Yönetimi</h3>

<button class="btn btn-primary"
@onclick="StokHareketiAc">
+ Stok Hareketi
</button>
<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>Parça Kodu</th>
            <th>Parça</th>
            <th>Raf</th>
            <th>Mevcut Stok</th>
            <th>Minimum Stok</th>
            <th>Durum</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var parca in parcalar)
        {
            <tr>
                <td>@parca.ParcaKodu</td>
                <td>@parca.ParcAdi</td>
                <td>@parca.Raf?.RafKodu</td>
                <td>@parca.MevcutStok</td>
                <td>@parca.MinimumStok</td>

                <td>
                    @if (parca.MevcutStok <= parca.MinimumStok)
                    {
                        <span class="badge bg-danger">
                            Kritik Stok
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            Yeterli
                        </span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<hr class="mt-5" />
<h4>Stok Hareketleri</h4>

@if (stokHareketleri.Count == 0)
{
    <p class="text-muted">
        Henüz stok hareketi bulunmuyor.
    </p>
}
else
{
    <table class="table table -striped table-hover mt-3">
        <thead>
            <tr>
                <th>Parça</th>
                <th>İşlem</th>
                <th>Miktar</th>
                <th>Depo</th>
                <th>Kullanıcı</th>
                <th>Tarih</th>
                <th>Açıklama</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var hareket in stokHareketleri.OrderByDescending( x=> x.Tarih))
            {
                <tr>
                    <td>
                        @hareket.Parca?.ParcAdi
                    </td>
                    <td>
                        @if (hareket.IslemTipi == "Giriş")
                        {
                            <span class="badge bg-success">
                                Giriş
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Çıkış
                            </span>
                        }
                    </td>
                    <td>
                        @(hareket.Miktar)
                    </td>
                     <td>
                         @(hareket.Depo?.Depaadi)
                     </td>

                     <td>
                         @(hareket.Kullanici?.AdSoyad)
                     </td>
                     <td>
                         @hareket.Tarih.ToString("dd.MM.yyyy HH:mm")
                     </td>
                     <td>
                         @(string.IsNullOrWhiteSpace(hareket.Aciklama)
                         ? "-"
                         :hareket.Aciklama)
                     </td>
                </tr>
            }
        </tbody>

    </table>
}

@if (showModal)
{
    <div class="modal d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5);">

        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Stok @islemTipi
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="ModalKapat">
                    </button>

                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label>Parça</label>

                        <select class="form-select"
                                @bind="yeniHareket.ParcaId">

                            <option value="0">
                                --Parça Seçin--
                            </option>

                            @foreach (var parca in parcalar)
                            {
                                <option value="@parca.Id">
                                    @parca.ParcAdi
                                </option>
                            }

                        </select>
                    </div>


                    <div class="mb-3">
                        <label>Depo</label>

                        <select class="form-select"
                                @bind="yeniHareket.DepoId">

                            <option value="0">
                                --Depo Seçin--
                            </option>

                            @foreach (var depo in depolar)
                            {
                                <option value="@depo.Id">
                                    @depo.Depaadi
                                </option>
                            }

                        </select>
                    </div>


                    <div class="mb-3">
                        <label>Kullanıcı</label>

                        <select class="form-select"
                                @bind="yeniHareket.KullaniciId">

                            <option value="0">
                                --Kullanıcı Seçin--
                            </option>

                            @foreach (var user in users)
                            {
                                <option value="@user.Id">
                                    @user.AdSoyad
                                </option>
                            }

                        </select>
                    </div>


                    <div class="mb-3">
                        <label>İşlem Tipi</label>

                        <select class="form-select"
                                @bind="yeniHareket.IslemTipi"
                                @bind:after="IslemTipiDegisti">

                            <option value="Giriş">
                                Giriş
                            </option>

                            <option value="Çıkış">
                                Çıkış
                            </option>

                        </select>
                    </div>
                    <div class="mb-3">
                        <label>Miktar</label>

                        <input type="number"
                               min="1"
                               class="form-control"
                               @bind="yeniHareket.Miktar" />
                     @if (!string.IsNullOrEmpty(stokUyari))
                        {
                            <div class="alert alert-danger mt-2">
                                @stokUyari
                            </div>
                        }


                    </div>
                    <div class="mb-3">
                        <label>Açıklama</label>

                        <textarea class="form-control"
                                      @bind="yeniHareket.Aciklama">
                        </textarea>
                        </div>

                    </div>
                    <div class="modal-footer">

                        <button class="btn btn-secondary"
                                @onclick="ModalKapat">
                            İptal
                        </button>

                        <button class="btn @(yeniHareket.IslemTipi == "Giriş" ? "btn-success" :"btn-danger")"
                        @onclick="Kaydet">
                        @(yeniHareket.IslemTipi == "Giriş"
                        ? "Stok Girişi Yap"
                        :"Stok Çıkışı Yap")
                        </button>

                    </div>

                </div>
            </div>
        </div>
    }


@code
{
    private List<Parca> parcalar = new();
    private List<Depolar> depolar = new();
    private List<Users> users = new();
    private List<StokHareket> stokHareketleri = new();

    private StokHareket yeniHareket = new();

    private bool showModal = false;

    private string islemTipi = "Giriş";
    private string stokUyari = "";

    protected override void OnInitialized()
    {
        if (!UserSession.IsAdmin && !UserSession.IsDepo)
        {
            Navigation.NavigateTo("/dashboard"); 
        }
        VerileriYukle();
    }


    private void VerileriYukle()
    {
        parcalar = ParcaService.GetAllParca();
        depolar = DepoService.GetAll();
        users = UserService.GetAllUsers();
        stokHareketleri = StokHareketService.GetAll();
    }


    private void StokHareketiAc()
    {
        yeniHareket = new StokHareket();

        islemTipi = "Giriş";
        yeniHareket.IslemTipi = "Giriş";
        stokUyari = "";
        showModal = true;
    }


    private void ModalKapat()
    {
        showModal = false;
        stokUyari = "";
    }
    private void Kaydet()
    {
        stokUyari = "";
        if (yeniHareket.ParcaId == 0)
        {
            stokUyari = "Lütfen bir parça seçin.";
            return;
        }
        if (yeniHareket.DepoId == 0)
        {
            stokUyari = "Lütfen bir depo seçin.";
            return;
        }
        if (yeniHareket.KullaniciId == 0)
        {
            stokUyari = "Lütfen bir kullanıcı seçin.";
            return;
        }
        if (yeniHareket.Miktar <= 0)
        {
            stokUyari = "Miktar 0'dan büyük olmalıdır.";
            return;
        }

        var parca = ParcaService.GetById(yeniHareket.ParcaId);

        if (parca == null)
        {
            stokUyari = "Seçilen parça bulunamadı.";
            return;
        }
        if (yeniHareket.IslemTipi == "Çıkış")
        {
            if (parca.MevcutStok < yeniHareket.Miktar)
            {
                stokUyari =
                    $"Yetersiz stok! Mevcut stok: {parca.MevcutStok}, " +
                    $"istenen miktar: {yeniHareket.Miktar}.";

                return;
            }

            parca.MevcutStok -= yeniHareket.Miktar;
        }

        else
        {
            parca.MevcutStok += yeniHareket.Miktar;
        }
        ParcaService.UpdateParca(parca);
        yeniHareket.Tarih = DateTime.Now;
        StokHareketService.AddStokHareket(yeniHareket);
        VerileriYukle();
        showModal = false;
        yeniHareket = new StokHareket();

        stokUyari = "";
    }
    private void IslemTipiDegisti()
    {
        islemTipi = yeniHareket.IslemTipi;
        stokUyari = "";
    }
}