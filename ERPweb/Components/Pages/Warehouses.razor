@page "/warehouses"
@rendermode InteractiveServer
@using Erpyonetimi.Domain.Entities
@using Erpyonetimi.Data.Helpers;
@using Erpyonetimi.Application.Services.Interfaces
@using System.Threading.Tasks
@inject IDepoService DepoService
@inject ILogService LogService

<h3>Depo Yönetimi</h3>

<button class="btn btn-primary" 
@onclick="YeniDepo">
    +Yeni Depo
</button>
<div class="mt-3 mb-3">
    <input class="form-control"
    placeholder="Depo adı veya konum ara..."
    @bind="aramaMetni"
    @bind:event="oninput" />
</div>
<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>Depo Adı</th>
            <th>Konum</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var depo in depolar.Where(x=> x.Depaadi.ToLower().Contains(aramaMetni.ToLower())||
        x.Konum.ToLower().Contains(aramaMetni.ToLower())))
        {
    <tr>
    <td>@depo.Depaadi</td>
    <td>@depo.Konum</td>

      <td>
      <button class="btn btn-warning btn-sm"
      @onclick="() => Duzenle(depo)">
                        Düzenle
                    </button>

                    <button class="btn btn-danger btn-sm ms-2"
                            @onclick="() => Sil(depo.Id)">
                        Sil
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (showModal)
{
    <div class="modal d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5);">

        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        @(duzenlemeModu ? "Depo Düzenle" : "Yeni Depo")
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="ModalKapat">
                    </button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label>Depo Adı *</label>


                        @if (!string.IsNullOrEmpty(hataMesaji))
                        {
                            <div class="alert alert-danger">
                                @hataMesaji
                            </div>
                        }

                        <input class="form-control"
                               @bind="yeniDepo.Depaadi" />
                    </div>

                    <div class="mb-3">
                        <label>Konum *</label>

                        <input class="form-control"
                               @bind="yeniDepo.Konum" />
                    </div>

                </div>

                <div class="modal-footer">

                    <button class="btn btn-secondary"
                            @onclick="ModalKapat">
                        İptal
                    </button>

                    <button class="btn btn-success"
                            @onclick="Kaydet">
                        Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (silmeModal)
{
    <div class="modal d-block"
         tabindex="-1"
         style="background-color:rgba(0,0,0,0.5);">

        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        Depo Silme
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="SilmeyiIptalEt">
                    </button>
                </div>

                <div class="modal-body">

                    @if (!string.IsNullOrEmpty(hataMesaji))
                    {
                        <div class="alert alert-danger">
                            @hataMesaji
                        </div>
                    }

                    <p>
                        <strong>
                            @silinecekDepo?.Depaadi
                        </strong>
                        adlı depoyu silmek istediğinize emin misiniz?
                    </p>

                </div>

                <div class="modal-footer">

                    <button class="btn btn-secondary"
                            @onclick="SilmeyiIptalEt">
                        İptal
                    </button>

                    <button class="btn btn-danger"
                            @onclick="SilmeyiOnayla">
                        Evet, Sil
                    </button>

                </div>

            </div>
        </div>
    </div>
}

@code
{
	private bool showModal = false;
	private bool duzenlemeModu = false;
	private string aramaMetni = "";
	private bool silmeModal = false;
	private Depolar? silinecekDepo;
	private string hataMesaji = "";

	private List<Depolar> depolar = new();
	private Depolar yeniDepo = new();

	protected override async Task OnInitializedAsync()
	{
		depolar = await DepoService.GetAllAsync();
	}

	private void YeniDepo()
	{
		yeniDepo = new Depolar();
		duzenlemeModu = false;
		hataMesaji = "";
		showModal = true;
	}

	private void ModalKapat()
	{
		showModal = false;
		hataMesaji = "";
	}

	private async Task Kaydet()
	{
		hataMesaji = "";

		if (string.IsNullOrWhiteSpace(yeniDepo.Depaadi))
		{
			hataMesaji = "Depo adı boş bırakılamaz.";
			return;
		}

		if (string.IsNullOrWhiteSpace(yeniDepo.Konum))
		{
			hataMesaji = "Konum boş bırakılamaz.";
			return;
		}
		if (duzenlemeModu)
		{
			await DepoService.UpdateDepoAsync (yeniDepo);

			Log log = new Log();
			log.KullaniciId = UserSession.CurrentUser.Id;
			log.Tarih = DateTime.Now;
			log.Islem = "Depo Düzenleme";
			log.Aciklama = yeniDepo.Depaadi + " adlı depo düzenlendi";
			await LogService.AddAsync (log);
		}
        else
        {
            await DepoService.AddDepoAsync(yeniDepo);

            Log log = new Log();
            log.KullaniciId = UserSession.CurrentUser.Id;
            log.Tarih = DateTime.Now;
            log.Islem = "Depo Ekleme";
            log.Aciklama = yeniDepo.Depaadi + " adlı depo eklendi";

            await LogService.AddAsync(log);
        }

		depolar = await DepoService.GetAllAsync();
		showModal = false;
		duzenlemeModu = false;
		yeniDepo = new Depolar();
	}

	private void Duzenle(Depolar depo)
	{
		yeniDepo = new Depolar
        {
            Id = depo.Id,
            Depaadi = depo.Depaadi,
            Konum = depo.Konum
        };
		duzenlemeModu = true;
		showModal = true;
	}

	private void Sil(int id)
	{
		hataMesaji = "";
		silinecekDepo = depolar.FirstOrDefault(x => x.Id == id);

		if(silinecekDepo != null)
		{
			silmeModal = true;
		}
	}
	private async Task SilmeyiIptalEt()
	{
		silmeModal = false;
		silinecekDepo = null;
		hataMesaji = "";
	}
	private async Task SilmeyiOnayla()
	{
        if (silinecekDepo == null)
            return;
        try
        {
            await DepoService.DeleteDepoAsync(silinecekDepo);
            Log log = new Log();
            log.KullaniciId = UserSession.CurrentUser.Id;
            log.Tarih = DateTime.Now;
            log.Islem = "Depo Silme";
            log.Aciklama = silinecekDepo.Depaadi
            + "adlı depo silindi";
            await LogService.AddAsync(log);
            depolar = await DepoService.GetAllAsync ();
            hataMesaji = "";
            silmeModal = false;
            silinecekDepo = null;
        }
        catch (Exception ex)
        {
            hataMesaji = ex.Message;
        }
    }
}

   


