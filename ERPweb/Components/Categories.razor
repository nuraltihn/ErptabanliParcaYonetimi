@page "/categories"
@rendermode InteractiveServer
@using System.Threading.Tasks
@using Erpyonetimi.Domain.Entities
@using Erpyonetimi.Application.Services.Interfaces
@using Erpyonetimi.Data.Helpers
@inject IKategoriService KategoriService
@inject NavigationManager Navigation
@inject ILogService LogService



<h3>Kategori Yönetimi</h3>
<hr />

<button class="btn btn-primary" @onclick="YeniKategori">
	+ Yeni Kategori
</button>

<div class="mt-3 mb-3">
	<input class="form-control"
	placeholder="Kategori ara..."
	@bind = "aramaMetni"
	@bind:event="oninput" />

</div>

@if (showModal)
{
	<div class="modal d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5);">
		<div class="modal-dialog">
			<div class="modal-content">

				<div class="modal-header">
					<h5 class="modal-title">
						@(duzenlemeModu ? "Kategori Düzenle" : "Yeni Kategori")
					</h5>
				</div>

				<div class="modal-body">

					@if (!string.IsNullOrEmpty(hataMesaji))
					{
						<div class="alert alert-danger">
							@hataMesaji
						</div>
					}

					<div class="mb-3">
						<label> Kategori Adı *</label>
						<input class="form-control"
						@bind="yeniKategori.KategoriAdi"/>
					</div>

					<div class="mb-3">
						<label>Açıklama</label>
						<textarea class="form-control"
									  @bind="yeniKategori.Aciklama"></textarea>	
					</div>

				
				</div>
				<div class="modal-footer">
					<button class="btn btn-secondary"
					@onclick="ModalKapat">
				İptal
			</button>
			<button class="btn btn-success"
			@onclick="Kaydet">
		Kaydet
	</button>
				</div>
			</div>
		</div>
	</div>
}
<hr />
<table class="table table-striped">
	<thead>
		<tr>
			<th>Kategori Adı</th>
			<th>Açıklama</th>
			<th>İşlemler</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var kategori in kategoriler.Where(x =>
		    x.KategoriAdi != null &&
			x.KategoriAdi.ToLower().Contains(aramaMetni.ToLower())))
		{
			<tr>
				<td>@kategori.KategoriAdi</td>
				<td>@kategori.Aciklama</td>
				<td>					<button class="btn btn-warning btn-sm ms-2"
					   @onclick="() => Duzenle(kategori)">
					   Düzenle </button>
					<button class="btn btn-danger btn-sm ms-2"
					@onclick="() => Sil(kategori.Id)">
				       Sil </button>

				</td>
			</tr>
		}
	</tbody>
</table>

@if (silmeModal)
{
	<div class="modal d-block"
		 tabindex="-1"
		 style="background-color:rgba(0,0,0,0.5);">

		<div class="modal-dialog">
			<div class="modal-content">

				<div class="modal-header">
					<h5 class="modal-title">Kategori Silme</h5>

					<button type="button"
							class="btn-close"
							@onclick="SilmeyiIptalEt">
					</button>
				</div>

				<div class="modal-body">
					@if(!string.IsNullOrEmpty(hataMesaji))
					{
						<div class="alert alert danger">
							@hataMesaji
						</div>
					}
					@if(string.IsNullOrEmpty(hataMesaji))
					{
						<p>
							<strong>@silinecekKategori?.KategoriAdi</strong>
							adlı kategoriyi silmek istediğinize emin misiniz?
						</p>
					}

				</div>

				<div class="modal-footer">

					<button class="btn btn-secondary"
							@onclick="SilmeyiIptalEt">
						İptal
					</button>

					<button class="btn btn-danger"
							@onclick="SilmeyiOnayla">
						Evet, Sil
					</button>

				</div>

			</div>
		</div>
	</div>
}

@code 
{
	private bool showModal = false;
	private bool duzenlemeModu = false;
	private string aramaMetni = "";
	private string hataMesaji = "";
	private List<Kategori> kategoriler = new();
	private Kategori yeniKategori = new();

	private bool silmeModal = false;
	private Kategori? silinecekKategori;

	private void Sil(int id)
	{
		silinecekKategori = kategoriler.FirstOrDefault(x => x.Id == id);
		if(silinecekKategori !=null)
		{
			silmeModal = true;
		}

	}
	private void SilmeyiIptalEt()
	{
		silmeModal=false;
		silinecekKategori = null;

	}
	private async Task SilmeyiOnayla()
	{
		if (silinecekKategori == null)
			return;

		try
		{
			await KategoriService.DeleteKategoriAsync(silinecekKategori.Id);

			Log log = new Log();
			log.KullaniciId = UserSession.CurrentUser.Id;
			log.Tarih = DateTime.Now;
			log.Islem = "Kategori Silme";
			log.Aciklama = silinecekKategori.KategoriAdi + " adlı kategori silindi";
			await LogService.AddAsync(log);

			kategoriler = await KategoriService.GetAllKategoriAsync();

			silmeModal = false;
			silinecekKategori = null;
			hataMesaji = "";
		}
		catch (Exception ex)
		{
			hataMesaji = ex.Message;

		}
		silmeModal = false;
		silinecekKategori = null;
	}
	
	
	protected override async Task OnInitializedAsync()
	{
		if (!UserSession.IsAdmin)
		{
			Navigation.NavigateTo("/dashboard");
			return;
		}
		kategoriler = await KategoriService.GetAllKategoriAsync();
	}
	private void YeniKategori()
	{
		yeniKategori = new Kategori();
		duzenlemeModu = false;
		hataMesaji = "";
		showModal = true;
	}	
	private void ModalKapat()
	{
		showModal = false;
	}
	private async Task Kaydet ()
	{ 
		hataMesaji ="";
		if(string.IsNullOrWhiteSpace(yeniKategori.KategoriAdi))
		{
			hataMesaji = "kategori adı boş bırakılmaz.";
			return;
		}
		if(duzenlemeModu)
		{
			await KategoriService.UpdateKategoriAsync(yeniKategori);
			Log log = new Log();
			log.KullaniciId = UserSession.CurrentUser.Id;
			log.Tarih = DateTime.Now;
			log.Islem = "Kategori Düzenleme";
			log.Aciklama = yeniKategori.KategoriAdi + " adlı kategori düzenlendi";
			await LogService.AddAsync(log);
		}
		else
		{
			await KategoriService.AddKategoriAsync(yeniKategori);
			Log log = new Log();
			log.KullaniciId = UserSession.CurrentUser.Id;
			log.Tarih = DateTime.Now;
			log.Islem = "Kategori Ekleme";
			log.Aciklama = yeniKategori.KategoriAdi + " adlı kategori eklendi";
			await LogService.AddAsync (log);
		}
		await KategoriService.AddKategoriAsync(yeniKategori);
		showModal = false;
		duzenlemeModu = false;
		yeniKategori = new Kategori();
	}
	private void Duzenle(Kategori kategori)
	{
		yeniKategori = new Kategori
		{
			Id = kategori.Id,
			KategoriAdi = kategori.KategoriAdi,
			Aciklama = kategori.Aciklama
		};

		duzenlemeModu = true;
		showModal = true;
	}
	
}
