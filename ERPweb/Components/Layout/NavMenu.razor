@using Erpyonetimi.Data.Helpers
@using Erpyonetimi.Application.Services.Interfaces
@using Erpyonetimi.Domain.Entities
@using System.Threading.Tasks
@inject NavigationManager Navigation
@inject ILogService LogService
@rendermode InteractiveServer

<div class="nav-menu-container">

<div class="logo-area">
	<img src="/images/logo.svg" alt="Özgenç Makina" />
</div>
<div class="nav-item px-3">
	<NavLink class="nav-link" href="/dashboard">
	Dashboard
	</NavLink>
</div>
@if (UserSession.IsAdmin)
{
	<div class="nav-item px-3">
		<NavLink class="nav-link" href="/users">
			Kullanıcı Yönetimi
		</NavLink>
	</div>

	<div class="nav-item px-3">
		<NavLink class="nav-link" href="/categories">
			Kategori Yönetimi
		</NavLink>
	</div>

	<div class="nav-item px-3">
		<NavLink class="nav-link" href="/suppliers">
			Tedarikçi Yönetimi
		</NavLink>
	</div>
	
}
@if (UserSession.IsAdmin|| UserSession.IsSatis)
{
	
	<div class="nav-item px-3">
		<NavLink class="nav-link" href="/parts">
			Parça Yönetimi
		</NavLink>
	</div>

	<div class="nav-item px-3">
		<NavLink class="nav-link" href="/customers">
			Müşteri Yönetimi
		</NavLink>
	</div>

	<div class="nav-item px-3">
		<NavLink class="nav-link" href="/Orders">
			Sipariş Yönetimi
		</NavLink>
	</div>

}

@if (UserSession.IsAdmin || UserSession.IsDepo)
{
	<div class="nav-item px-3">
		<NavLink class="nav-link" href="/warehouses">
			Depo Yönetimi
		</NavLink>
	</div>

	<div class="nav-item px-3">
		<NavLink class="nav-link" href="/shelves">
			Raf Yönetimi
		</NavLink>
	</div>


	<div class="nav-item px-3">
		<NavLink class="nav-link" href="/stockmovements">
			Stok Yönetimi
		</NavLink>
	</div>
}
@if (UserSession.IsAdmin)
{
	<div class="nav-item px-3">
		<NavLink class="nav-link" href="/logs">
			Log Kayıtları
		</NavLink>
	</div>
}
<div class="user-area">
	<div class="user-profile">

		<div class="user-avatar @GetRoleClass()">
			@GetInitials()
		</div>

		<div class="user-info">
			<div class="user-name">
				@UserSession.CurrentUser?.AdSoyad
			</div>

			<div class="user-role @GetRoleClass()">
				@GetRoleName()
			</div>
		</div>

	</div>

	<button class="logout-button" @onclick="CikisYap">
		Çıkış Yap
	</button>
</div>
</div>
@code
{
	private async Task CikisYap()
	{
		Log log = new Log();
		log.KullaniciId = UserSession.CurrentUser!.Id;
		log.Tarih = DateTime.Now;
		log.Islem = "Kullanıcı Çıkışı";
		log.Aciklama = "Sistemden çıkış yaptı";

		await LogService.AddAsync(log);

		Navigation.NavigateTo("/login", true);
	}
	private string GetInitials()
	{
		if (UserSession.CurrentUser == null)
			return "?";
		var isim = UserSession.CurrentUser.AdSoyad;
		if (string.IsNullOrWhiteSpace(isim))
			return"?";
		var kelimeler = isim
		.Split(' ', StringSplitOptions.RemoveEmptyEntries);

		if (kelimeler.Length == 1)
			return kelimeler[0][0].ToString().ToUpper();

		return $"{kelimeler[0][0]}{kelimeler[^1][0]}".ToUpper();
	}
	private string GetRoleName()
	{
		if (UserSession.IsAdmin)
			return "Yönetici";

		if (UserSession.IsDepo)
			return "Depo Görevlisi";

		if (UserSession.IsSatis)
			return "Satış Temsilcisi";

		return "Kullanıcı";
	}

	private string GetRoleClass()
	{
		if (UserSession.IsAdmin)
			return "role-admin";

		if (UserSession.IsDepo)
			return "role-depo";

		if (UserSession.IsSatis)
			return "role-satis";

		return "role-user";
	}
	}