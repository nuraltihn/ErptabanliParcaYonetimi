@inherits LayoutComponentBase
@inject NavigationManager Navigation
@if(Navigation.Uri.Contains("/login"))
{
	<main>
		@Body
		</main>

}
else
{
	<div class="page">
		<div class="sidebar">
			<NavMenu />
		</div>

		<main>
			<div class="top-row px-4">
				<a>href="https://learn.microsoft.com/aspnet/core/"</a> 

		</div>
			<article class="content px-4">
				@Body
			</article>
				</main>
	</div>
} 