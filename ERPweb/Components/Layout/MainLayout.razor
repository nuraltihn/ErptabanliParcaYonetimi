@inherits LayoutComponentBase
@inject NavigationManager Navigation
@if(Navigation.Uri.Contains("/login"))
{
	<main>
		@Body
		</main>

}
else
{
	<div class="page">
		<div class="sidebar">
			<NavMenu />
		</div>

		<main>
			
			<article class="content px-4">
				@Body
			</article>
				</main>
	</div>
} 