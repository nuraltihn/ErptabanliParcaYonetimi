    </PackageReference>
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Erpyonetimi.Application\Erpyonetimi.Application.csproj" />
